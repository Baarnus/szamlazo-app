---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import LandingView from "../components/LandingView.astro";
import Dashboard from "../components/Dashboard.astro";
import AuthModal from "../components/modals/AuthModal.astro";
import BillingModal from "../components/modals/BillingModal.astro";
import SettingsModal from "../components/modals/SettingsModal.astro";
import SplitViewModal from "../components/modals/SplitViewModal.astro";
const umamiUrl = import.meta.env.PUBLIC_UMAMI_URL;
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const enableUmami = Boolean(umamiUrl && umamiWebsiteId && import.meta.env.PUBLIC_ENABLE_UMAMI !== 'false');
---

<html lang="hu" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Google Consent Mode v2 Default Setup -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        'analytics_storage': 'denied',
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'wait_for_update': 500
      });
      gtag('set', 'url_passthrough', true);
    </script>
    
    <!-- CookieConsent V3 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@v3.0.0/dist/cookieconsent.css">

    {enableUmami && (
      <script
        defer
        src={umamiUrl}
        data-website-id={umamiWebsiteId}></script>
    )}
    <title>Számla AI - AI Számlagenerátor & Könyvelési OCR</title>
  </head>
  <body class="min-h-screen bg-base-300 p-3 md:p-8 font-sans">
    <div class="max-w-5xl mx-auto space-y-6">
      <Navbar />
      <LandingView />
      <Dashboard />
    </div>

    <!-- LÁBLÉC (JOGI DOKUMENTUMOK) -->
    <footer class="footer footer-center p-6 bg-base-200 text-base-content rounded-t-lg mt-10">
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/aszf" class="link link-hover text-sm">Általános Szerződési Feltételek (ÁSZF)</a>
        <a href="/adatvedelem" class="link link-hover text-sm">Adatvédelmi Tájékoztató (GDPR)</a>
      </div>
      <div>
        <p class="text-xs opacity-70">Copyright © 2026 - Minden jog fenntartva | Számla AI</p>
      </div>
    </footer>

    <!-- MODÁLOK -->
    <BillingModal />
    <AuthModal />
    <SettingsModal />
    <SplitViewModal />

    <!-- MODERN DAISYUI TOAST CONTAINER -->
    <div id="toastContainer" class="toast toast-top toast-end z-50 hidden">
      <div
        id="toastAlert"
        class="alert alert-success shadow-lg text-xs font-semibold py-2.5 px-4 flex items-center gap-2"
      >
        <span id="toastMessage">Sikeres művelet!</span>
      </div>
    </div>

    <!-- KLIENSOLDALI FŐ MODUL -->
    <script src="../scripts/main.ts"></script>
  </body>
</html>
