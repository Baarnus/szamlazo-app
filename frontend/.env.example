# Backend API elérési címe a böngészőből
PUBLIC_API_URL=http://localhost:3000

# Umami Analytics beállítások (opcionális, csak ha analitika szükséges)
# Ha nincs megadva, semmilyen külső követőkód nem töltődik be.
PUBLIC_UMAMI_URL=
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_ENABLE_UMAMI=false
