              <td class="col-span-full sm:table-cell p-0 sm:p-2">
                <div class="sm:hidden flex justify-between items-center mb-1">
                  <span class="text-[11px] font-bold text-primary">#${i + 1} Tétel megnevezése</span>
                  <button type="button" class="btn btn-ghost btn-xs text-error btn-circle remove-item-btn" data-index="${i}" title="Tétel törlése">&times;</button>
                </div>
                <input type="text" class="input input-sm sm:input-xs input-bordered w-full item-name font-medium" data-index="${i}" value="${t.megnevezes || ""}" placeholder="Tétel megnevezése" />
              </td>
              <td class="sm:table-cell p-0 sm:p-2">
                <div class="sm:hidden text-[10px] text-base-content/60 font-semibold mb-0.5">Mennyiség</div>
                <input type="number" step="any" class="input input-sm sm:input-xs input-bordered w-full text-right item-qty" data-index="${i}" value="${t.mennyiseg || 1}" />
              </td>
              <td class="sm:table-cell p-0 sm:p-2">
                <div class="sm:hidden text-[10px] text-base-content/60 font-semibold mb-0.5">Egységár</div>
                <input type="number" step="any" class="input input-sm sm:input-xs input-bordered w-full text-right item-unit" data-index="${i}" value="${t.egysegar || 0}" />
              </td>
              <td class="sm:table-cell p-0 sm:p-2">
                <div class="sm:hidden text-[10px] text-base-content/60 font-semibold mb-0.5">Áfa %</div>
                <input type="number" step="any" class="input input-sm sm:input-xs input-bordered w-full text-right item-vat-rate" data-index="${i}" value="${t.afa_szazalek || 0}" />
              </td>
              <td class="sm:table-cell p-1 sm:p-2 text-left sm:text-right font-medium text-xs">
