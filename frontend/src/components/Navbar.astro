---
// frontend/src/components/Navbar.astro
---
<header
  class="navbar bg-base-100 shadow-lg rounded-box px-3 md:px-6 py-2 flex justify-between items-center border border-base-200"
>
  <!-- Bal: Logo -->
  <div class="flex items-center gap-2 min-w-0">
    <span class="text-2xl shrink-0">🧾</span>
    <div class="min-w-0">
      <h1
        class="font-extrabold text-base sm:text-lg md:text-xl text-primary tracking-tight whitespace-nowrap"
      >
        Számla AI
      </h1>
      <p class="text-[10px] text-base-content/50 hidden sm:block truncate">
        Automatikus számlafeldolgozás másodpercek alatt
      </p>
    </div>
  </div>

  <!-- Jobb: Bejelentkezett állapot -->
  <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
    <!-- BEJELENTKEZETT ÁLLAPOT -->
    <div id="userProfileBar" class="hidden items-center gap-1.5 sm:gap-2">
      <!-- Kredit badge: mobilon rövidebb -->
      <div
        class="badge badge-primary font-semibold text-xs py-2.5 px-2 sm:px-3 gap-1 shadow-sm whitespace-nowrap"
      >
        <span>⚡</span>
        <span id="userCreditsDisplay">0</span>
        <span class="opacity-80 font-normal hidden sm:inline">kredit</span>
      </div>

      <!-- Feltöltés gomb -->
      <button
        type="button"
        id="openBillingBtn"
        class="btn btn-xs bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-2 sm:px-3 border-0 shadow whitespace-nowrap"
      >
        <span class="hidden sm:inline">+</span>
        <span class="sm:hidden">💳</span>
        <span class="hidden sm:inline">Feltöltés</span>
      </button>

      <!-- Beállítások: mobilon csak ikon -->
      <button
        type="button"
        id="openSettingsBtn"
        class="btn btn-ghost btn-xs text-base-content font-medium px-1.5 sm:px-2"
        title="Beállítások"
      >
        <span class="sm:hidden text-base">⚙️</span>
        <span class="hidden sm:inline">⚙️ Beállítások</span>
      </button>

      <!-- Kijelentkezés: mobilon csak ikon -->
      <button
        type="button"
        id="logoutBtn"
        class="btn btn-ghost btn-xs text-error font-medium px-1.5 sm:px-2"
        title="Kijelentkezés"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
        <span class="hidden sm:inline">Kijelentkezés</span>
      </button>
    </div>

    <!-- KIJELENTKEZETT ÁLLAPOT -->
    <div id="guestNavAction" class="flex items-center gap-2">
      <button
        id="openAuthModalBtn"
        type="button"
        class="btn btn-primary btn-sm gap-1 shadow-md"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
          ></path>
        </svg>
        <span class="hidden xs:inline">Belépés / Fiók</span>
        <span class="xs:hidden">Belépés</span>
      </button>
    </div>
  </div>
</header>
