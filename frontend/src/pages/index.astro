        editItemsTbody.innerHTML = "";

        const cur = editPenznem.value || "HUF";

        (currentEditingData.tetelek || []).forEach((t, i) => {
          const tr = document.createElement("tr");
          tr.className = "mobile-item-card sm:table-row border-b border-base-300 sm:border-0";
