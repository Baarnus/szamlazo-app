---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import LandingView from "../components/LandingView.astro";
import Dashboard from "../components/Dashboard.astro";
import AuthModal from "../components/modals/AuthModal.astro";
import BillingModal from "../components/modals/BillingModal.astro";
import SettingsModal from "../components/modals/SettingsModal.astro";
import SplitViewModal from "../components/modals/SplitViewModal.astro";
---

<html lang="hu" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Google Consent Mode v2 Default Setup -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        'analytics_storage': 'denied',
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'wait_for_update': 500
      });
      gtag('set', 'url_passthrough', true);
    </script>
    
    <!-- CookieConsent V3 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@v3.0.0/dist/cookieconsent.css">

    <script
      defer
      src="https://umami-89-58-60-86.sslip.io/script.js"
      data-website-id="70ac19ad-2a82-40b9-b32d-aa6a46daad84"></script>
    <title>Számla AI - AI Számlagenerátor & Könyvelési OCR</title>
  </head>
  <body class="min-h-screen bg-base-300 p-3 md:p-8 font-sans">
    <div class="max-w-5xl mx-auto space-y-6">
      <Navbar />
      <LandingView />
      <Dashboard />
    </div>

    <!-- LÁBLÉC (JOGI DOKUMENTUMOK) -->
    <footer class="footer footer-center p-6 bg-base-200 text-base-content rounded-t-lg mt-10">
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/aszf" class="link link-hover text-sm">Általános Szerződési Feltételek (ÁSZF)</a>
        <a href="/adatvedelem" class="link link-hover text-sm">Adatvédelmi Tájékoztató (GDPR)</a>
      </div>
      <div>
        <p class="text-xs opacity-70">Copyright © 2026 - Minden jog fenntartva | Számla AI</p>
      </div>
    </footer>

    <!-- MODÁLOK -->
    <BillingModal />
    <AuthModal />
    <SettingsModal />
    <SplitViewModal />

    <!-- MODERN DAISYUI TOAST CONTAINER -->
    <div id="toastContainer" class="toast toast-top toast-end z-50 hidden">
      <div
        id="toastAlert"
        class="alert alert-success shadow-lg text-xs font-semibold py-2.5 px-4 flex items-center gap-2"
      >
        <span id="toastMessage">Sikeres művelet!</span>
      </div>
    </div>

    <script>
      import type {
        ImageInputItem,
        SingleInvoiceResult,
        InvoiceData,
      } from "../../../shared/types";
      import { SUPPORTED_CURRENCIES } from "../../../shared/types";

      const API_BASE =
        import.meta.env.PUBLIC_API_URL || "http://localhost:3000";

      // Nézetek
      const guestLandingView = document.getElementById(
        "guestLandingView",
      ) as HTMLElement;
      const appDashboardView = document.getElementById(
        "appDashboardView",
      ) as HTMLElement;
      const guestNavAction = document.getElementById(
        "guestNavAction",
      ) as HTMLElement;

      // Toast értesítő
      function showToast(
        message: string,
        type: "success" | "error" | "info" = "success",
      ) {
        const container = document.getElementById("toastContainer");
        const alertBox = document.getElementById("toastAlert");
        const msgSpan = document.getElementById("toastMessage");
        if (!container || !alertBox || !msgSpan) return;

        alertBox.className = `alert alert-${type} shadow-xl text-xs font-semibold py-2.5 px-4 flex items-center gap-2`;
        msgSpan.textContent = message;
        container.classList.remove("hidden");

        setTimeout(() => {
          container.classList.add("hidden");
        }, 4000);
      }

      // Auth Elemek
      let invoiceToDeleteDbId: string | null = null;
      let invoiceToDeleteIndex: number | null = null;
      let invoiceToDeleteBtn: HTMLButtonElement | null = null;
      const deleteInvoiceConfirmModal = document.getElementById("deleteInvoiceConfirmModal") as HTMLDialogElement;
      const confirmDeleteInvoiceBtn = document.getElementById("confirmDeleteInvoiceBtn") as HTMLButtonElement;

      confirmDeleteInvoiceBtn?.addEventListener("click", async () => {
        if (!invoiceToDeleteDbId || invoiceToDeleteIndex === null || !invoiceToDeleteBtn) return;
        const btn = confirmDeleteInvoiceBtn;
        btn.disabled = true;
        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<span class="loading loading-spinner loading-xs"></span>';
        try {
          const res = await fetch(`${API_BASE}/api/invoices/${invoiceToDeleteDbId}`, {
            method: 'DELETE',
            headers: { Authorization: `Bearer ${authToken}` }
          });
          const data = await res.json();
          if (data.success) {
            showToast("Számla sikeresen törölve.", "success");
            lastProcessedResults.splice(invoiceToDeleteIndex, 1);
            renderResultsCards();
            deleteInvoiceConfirmModal.close();
          } else {
            showToast(data.error || "Hiba történt a törlés során.", "error");
          }
        } catch (err) {
          showToast("Hálózati hiba a törléskor.", "error");
        } finally {
          btn.disabled = false;
          btn.innerHTML = originalHtml;
        }
      });

      const authModal = document.getElementById(
        "authModal",
      ) as HTMLDialogElement;
      const openAuthModalBtn = document.getElementById(
        "openAuthModalBtn",
      ) as HTMLButtonElement;
      const authTabLogin = document.getElementById(
        "authTabLogin",
      ) as HTMLAnchorElement;
      const authTabRegister = document.getElementById(
        "authTabRegister",
      ) as HTMLAnchorElement;
      const authForm = document.getElementById("authForm") as HTMLFormElement;
      const authEmail = document.getElementById(
        "authEmail",
      ) as HTMLInputElement;
      const authPassword = document.getElementById(
        "authPassword",
      ) as HTMLInputElement;
      const authSubmitBtn = document.getElementById(
        "authSubmitBtn",
      ) as HTMLButtonElement;
      const authErrorAlert = document.getElementById(
        "authErrorAlert",
      ) as HTMLDivElement;
      const userProfileBar = document.getElementById(
        "userProfileBar",
      ) as HTMLDivElement;
      const userCreditsDisplay = document.getElementById(
        "userCreditsDisplay",
      ) as HTMLSpanElement;
      const logoutBtn = document.getElementById(
        "logoutBtn",
      ) as HTMLButtonElement;

      // Billing Modal Elemek
      const billingModal = document.getElementById(
        "billingModal",
      ) as HTMLDialogElement;
      const openBillingBtn = document.getElementById(
        "openBillingBtn",
      ) as HTMLButtonElement;

      let authMode: "login" | "register" | "reset" = "login";
      let authToken: string | null = localStorage.getItem("szamla_ai_token");

      // UI Elemek
      const tabUpload = document.getElementById(
        "tabUpload",
      ) as HTMLAnchorElement;
      const tabUrl = document.getElementById("tabUrl") as HTMLAnchorElement;
      const tabTextPrompt = document.getElementById("tabTextPrompt") as HTMLAnchorElement;
      const panelUpload = document.getElementById(
        "panelUpload",
      ) as HTMLDivElement;
      const panelUrl = document.getElementById("panelUrl") as HTMLDivElement;
      const panelTextPrompt = document.getElementById("panelTextPrompt") as HTMLDivElement;

      const cameraBtn = document.getElementById(
        "cameraBtn",
      ) as HTMLButtonElement;
      const cameraInput = document.getElementById(
        "cameraInput",
      ) as HTMLInputElement;
      const dropZone = document.getElementById("dropZone") as HTMLDivElement;
      const fileInput = document.getElementById(
        "fileInput",
      ) as HTMLInputElement;
      const previewContainer = document.getElementById(
        "previewContainer",
      ) as HTMLDivElement;
      const previewGrid = document.getElementById(
        "previewGrid",
      ) as HTMLDivElement;
      const fileCountBadge = document.getElementById(
        "fileCountBadge",
      ) as HTMLSpanElement;
      const clearFilesBtn = document.getElementById(
        "clearFilesBtn",
      ) as HTMLButtonElement;

      const urlInput = document.getElementById(
        "urlInput",
      ) as HTMLTextAreaElement;
      const textPromptInput = document.getElementById(
        "textPromptInput",
      ) as HTMLTextAreaElement;
      const processBtn = document.getElementById(
        "processBtn",
      ) as HTMLButtonElement;
      const statusAlert = document.getElementById(
        "statusAlert",
      ) as HTMLDivElement;
      const statusMessage = document.getElementById(
        "statusMessage",
      ) as HTMLSpanElement;
      const progressBar = document.getElementById(
        "progressBar",
      ) as HTMLProgressElement;
      const progressPercent = document.getElementById(
        "progressPercent",
      ) as HTMLSpanElement;
      const exportCsvBtn = document.getElementById(
        "exportCsvBtn",
      ) as HTMLButtonElement;
      const resultsWrapper = document.getElementById(
        "resultsWrapper",
      ) as HTMLDivElement;

      const logBoxContainer = document.getElementById(
        "logBoxContainer",
      ) as HTMLDivElement;
      const activityLog = document.getElementById(
        "activityLog",
      ) as HTMLDivElement;
      const logSpeedInfo = document.getElementById(
        "logSpeedInfo",
      ) as HTMLSpanElement;

      // Modal elemek
      const editModal = document.getElementById(
        "editModal",
      ) as HTMLDialogElement;
      const modalImage = document.getElementById(
        "modalImage",
      ) as HTMLImageElement;
      const modalImageLabel = document.getElementById(
        "modalImageLabel",
      ) as HTMLSpanElement;
      const modalImageLink = document.getElementById(
        "modalImageLink",
      ) as HTMLAnchorElement;
      const modalTextPrompt = document.getElementById(
        "modalTextPrompt",
      ) as HTMLDivElement;
      const modalValidBadge = document.getElementById(
        "modalValidBadge",
      ) as HTMLSpanElement;
      const modalWarningBox = document.getElementById(
        "modalWarningBox",
      ) as HTMLDivElement;

      const editKiallitoNeve = document.getElementById(
        "edit_kiallito_neve",
      ) as HTMLInputElement;
      const editKiallitoAdoszam = document.getElementById(
        "edit_kiallito_adoszam",
      ) as HTMLInputElement;
      const editSzamlaszam = document.getElementById(
        "edit_szamlaszam",
      ) as HTMLInputElement;
      const editVevoNeve = document.getElementById(
        "edit_vevo_neve",
      ) as HTMLInputElement;
      const editKeltDatum = document.getElementById(
        "edit_kelt_datum",
      ) as HTMLInputElement;
      const editFizetesiHatarido = document.getElementById(
        "edit_fizetesi_hatarido",
      ) as HTMLInputElement;
      const editPenznem = document.getElementById(
        "edit_penznem",
      ) as HTMLSelectElement;
      const editOrszag = document.getElementById(
        "edit_orszag",
      ) as HTMLInputElement;

      const editItemsTbody = document.getElementById(
        "editItemsTbody",
      ) as HTMLTableSectionElement;
      const addItemBtn = document.getElementById(
        "addItemBtn",
      ) as HTMLButtonElement;
      const displayNetto = document.getElementById(
        "displayNetto",
      ) as HTMLElement;
      const displayAfa = document.getElementById("displayAfa") as HTMLElement;
      const displayBrutto = document.getElementById(
        "displayBrutto",
      ) as HTMLElement;
      const legalLiabilityCheckbox = document.getElementById(
        "legalLiabilityCheckbox",
      ) as HTMLInputElement;
      const issueSzamlazzHuBtn = document.getElementById(
        "issueSzamlazzHuBtn",
      ) as HTMLButtonElement;
      
      legalLiabilityCheckbox.addEventListener("change", (e) => {
        issueSzamlazzHuBtn.disabled = !legalLiabilityCheckbox.checked;
      });

      const saveChangesBtn = document.getElementById(
        "saveChangesBtn",
      ) as HTMLButtonElement;
      const cancelModalBtn = document.getElementById(
        "cancelModalBtn",
      ) as HTMLButtonElement;

      // Split View Mobile Tabs & Responsive Handlers
      const splitTabForm = document.getElementById("splitTabForm") as HTMLButtonElement | null;
      const splitTabPreview = document.getElementById("splitTabPreview") as HTMLButtonElement | null;
      const splitTabPreviewIcon = document.getElementById("splitTabPreviewIcon") as HTMLSpanElement | null;
      const splitTabPreviewLabel = document.getElementById("splitTabPreviewLabel") as HTMLSpanElement | null;
      const modalPreviewCol = document.getElementById("modalPreviewCol") as HTMLDivElement | null;
      const modalFormCol = document.getElementById("modalFormCol") as HTMLDivElement | null;
      const quickViewDocBtn = document.getElementById("quickViewDocBtn") as HTMLButtonElement | null;
      const quickViewDocIcon = document.getElementById("quickViewDocIcon") as HTMLSpanElement | null;
      const quickViewDocLabel = document.getElementById("quickViewDocLabel") as HTMLSpanElement | null;
      const backToFormBtn = document.getElementById("backToFormBtn") as HTMLButtonElement | null;

      function switchSplitViewTab(tab: "form" | "preview") {
        if (!splitTabForm || !splitTabPreview || !modalPreviewCol || !modalFormCol) return;
        if (tab === "form") {
          splitTabForm.classList.add("btn-primary");
          splitTabForm.classList.remove("btn-ghost");
          splitTabPreview.classList.remove("btn-primary");
          splitTabPreview.classList.add("btn-ghost");

          modalFormCol.classList.remove("hidden");
          modalFormCol.classList.add("flex");
          modalPreviewCol.classList.add("hidden");
          modalPreviewCol.classList.remove("flex");
        } else {
          splitTabPreview.classList.add("btn-primary");
          splitTabPreview.classList.remove("btn-ghost");
          splitTabForm.classList.remove("btn-primary");
          splitTabForm.classList.add("btn-ghost");

          modalPreviewCol.classList.remove("hidden");
          modalPreviewCol.classList.add("flex");
          modalFormCol.classList.add("hidden");
          modalFormCol.classList.remove("flex");
        }
      }

      splitTabForm?.addEventListener("click", () => switchSplitViewTab("form"));
      splitTabPreview?.addEventListener("click", () => switchSplitViewTab("preview"));
      quickViewDocBtn?.addEventListener("click", () => switchSplitViewTab("preview"));
      backToFormBtn?.addEventListener("click", () => switchSplitViewTab("form"));

      let currentMode: "upload" | "url" | "text" = "upload";
      let selectedFiles: File[] = [];
      let inputItemsCache: ImageInputItem[] = [];
      let lastProcessedResults: (SingleInvoiceResult & { dbId?: string })[] =
        [];
      let activeEditIndex: number = -1;
      let currentEditingData: InvoiceData | null = null;

      // ==========================================
      // AUTH KEZELÉS & NÉZETVÁLTÁS
      // ==========================================
      const urlParams = new URLSearchParams(window.location.search);
      const resetToken = urlParams.get("resetToken");
      if (resetToken) authMode = "reset";

      const authModalTitle = document.getElementById("authModalTitle") as HTMLHeadingElement;
      const forgotPasswordContainer = document.getElementById("forgotPasswordContainer") as HTMLDivElement;
      
      function setAuthModalMode(mode: "login" | "register" | "reset") {
        authMode = mode;
        const emailDiv = authEmail.parentElement;
        
        if (mode === "login") {
          authModalTitle.textContent = "Bejelentkezés";
          authTabLogin.classList.add("tab-active");
          authTabRegister.classList.remove("tab-active");
          authSubmitBtn.textContent = "Bejelentkezés";
          if (forgotPasswordContainer) forgotPasswordContainer.classList.remove("hidden");
          if (emailDiv) emailDiv.classList.remove("hidden");
          authEmail.required = true;
          authPassword.placeholder = "••••••••";
        } else if (mode === "register") {
          authModalTitle.textContent = "Regisztráció";
          authTabRegister.classList.add("tab-active");
          authTabLogin.classList.remove("tab-active");
          authSubmitBtn.textContent = "Ingyenes Regisztráció (15 kredit)";
          if (forgotPasswordContainer) forgotPasswordContainer.classList.add("hidden");
          if (emailDiv) emailDiv.classList.remove("hidden");
          authEmail.required = true;
          authPassword.placeholder = "••••••••";
        } else if (mode === "reset") {
          authModalTitle.textContent = "Új jelszó beállítása";
          authTabLogin.style.display = "none";
          authTabRegister.style.display = "none";
          authSubmitBtn.textContent = "Jelszó mentése";
          if (forgotPasswordContainer) forgotPasswordContainer.classList.add("hidden");
          if (emailDiv) emailDiv.classList.add("hidden");
          authEmail.required = false;
          authPassword.placeholder = "Új jelszó (min. 6 karakter)";
        }
      }

      openAuthModalBtn.addEventListener("click", () => {
        setAuthModalMode("login");
        authModal.showModal();
      });

      if (resetToken && authModal) {
        setAuthModalMode("reset");
        authModal.showModal();
      }

      authTabLogin.addEventListener("click", () => setAuthModalMode("login"));
      authTabRegister.addEventListener("click", () =>
        setAuthModalMode("register"),
      );
      
      const forgotPasswordLink = document.getElementById("forgotPasswordLink") as HTMLAnchorElement;
      if (forgotPasswordLink) {
        forgotPasswordLink.addEventListener("click", async (e) => {
          e.preventDefault();
          if (!authEmail.value) {
            authErrorAlert.textContent = "Kérjük, add meg az e-mail címedet a jelszó visszaállításához!";
            authErrorAlert.classList.remove("hidden");
            return;
          }
          authErrorAlert.classList.add("hidden");
          const originalText = authSubmitBtn.textContent;
          authSubmitBtn.textContent = "Folyamatban...";
          authSubmitBtn.disabled = true;
          
          try {
            const res = await fetch(`${API_BASE}/api/auth/forgot-password`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ email: authEmail.value })
            });
            const data = await res.json();
            if (res.ok && data.success) {
              showToast("Jelszó visszaállító link elküldve az e-mail címedre (Nézd meg a Spam mappát is!).", "success");
              authModal.close();
            } else {
              authErrorAlert.textContent = data.error || "Hiba történt a kiküldés során.";
              authErrorAlert.classList.remove("hidden");
            }
          } catch (err) {
            authErrorAlert.textContent = "Hálózati hiba történt.";
            authErrorAlert.classList.remove("hidden");
          } finally {
            if (authSubmitBtn.textContent === "Folyamatban...") authSubmitBtn.textContent = originalText || "Bejelentkezés";
            authSubmitBtn.disabled = false;
          }
        });
      }

      // Landing CTA gombok eseményei
      document.querySelectorAll(".hero-register-cta").forEach((btn) => {
        btn.addEventListener("click", () => {
          setAuthModalMode("register");
          authModal.showModal();
        });
      });

      authForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        authErrorAlert.classList.add("hidden");
        authSubmitBtn.disabled = true;

        try {
          if (authMode === "reset") {
            const res = await fetch(`${API_BASE}/api/auth/reset-password`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                token: resetToken,
                newPassword: authPassword.value,
              }),
            });
            const data = await res.json();
            if (!res.ok || !data.success) {
              throw new Error(data.error || "Hiba történt a jelszó visszaállításakor.");
            }
            
            showToast("Sikeres jelszó visszaállítás! Kérjük, jelentkezz be.", "success");
            window.location.href = "/";
            return;
          }
          
          const endpoint =
            authMode === "login" ? "/api/auth/login" : "/api/auth/register";
          const res = await fetch(`${API_BASE}${endpoint}`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              email: authEmail.value,
              password: authPassword.value,
            }),
          });

          let data;
          try {
            const textResponse = await res.text();
            data = JSON.parse(textResponse);
          } catch (e) {
            throw new Error("A szerver nem megfelelő formátumban válaszolt (valószínűleg nem fut a backend, vagy rossz URL-re mutat).");
          }

          if (!res.ok || !data.success) {
            throw new Error(data.error || "Hiba történt a hitelesítéskor.");
          }

          authToken = data.token;
          if (authToken) localStorage.setItem("szamla_ai_token", authToken);

          updateUserUI(data.user);
          authModal.close();
          loadInvoicesFromDatabase();
          showToast(
            authMode === "login"
              ? "Sikeres bejelentkezés!"
              : "Sikeres regisztráció! 15 kredit jóváírva.",
            "success",
          );
        } catch (err: any) {
          authErrorAlert.textContent = err.message;
          authErrorAlert.classList.remove("hidden");
        } finally {
          authSubmitBtn.disabled = false;
        }
      });

      logoutBtn.addEventListener("click", () => {
        localStorage.removeItem("szamla_ai_token");
        authToken = null;
        userProfileBar.classList.add("hidden");
        userProfileBar.classList.remove("flex");
        guestNavAction.classList.remove("hidden");

        // Nézet visszaállítása Landingre
        guestLandingView.classList.remove("hidden");
        appDashboardView.classList.add("hidden");

        resultsWrapper.innerHTML = "";
        lastProcessedResults = [];
        exportCsvBtn.classList.add("hidden"); exportRlbBtn.classList.add("hidden");
        showToast("Sikeresen kijelentkeztél.", "info");
      });

      async function checkCurrentSession() {
        authToken = localStorage.getItem("szamla_ai_token");
        if (!authToken) {
          userProfileBar.classList.add("hidden");
          userProfileBar.classList.remove("flex");
          guestNavAction.classList.remove("hidden");
          guestLandingView.classList.remove("hidden");
          appDashboardView.classList.add("hidden");
          return;
        }

        try {
          const res = await fetch(`${API_BASE}/api/auth/me`, {
            headers: { Authorization: `Bearer ${authToken}` },
          });
          const data = await res.json();

          if (res.ok && data.success && data.user) {
            updateUserUI(data.user);
            loadInvoicesFromDatabase();
          } else if (res.status === 401 || res.status === 403) {
            localStorage.removeItem("szamla_ai_token");
            authToken = null;
            userProfileBar.classList.add("hidden");
            userProfileBar.classList.remove("flex");
            guestNavAction.classList.remove("hidden");
            guestLandingView.classList.remove("hidden");
            appDashboardView.classList.add("hidden");
          }
        } catch (err) {
          console.error("Session ellenőrzési hiba:", err);
        }
      }

      function updateUserUI(user: { email: string; credits: number }) {
        userCreditsDisplay.textContent = String(user.credits ?? 0);
        userProfileBar.classList.remove("hidden");
        userProfileBar.classList.add("flex");
        guestNavAction.classList.add("hidden");

        // Váltás app nézetre
        guestLandingView.classList.add("hidden");
        appDashboardView.classList.remove("hidden");
      }

      // ==========================================
      // BEÁLLÍTÁSOK / SETTINGS LOGIKA
      // ==========================================

      const settingsModal = document.getElementById("settingsModal") as HTMLDialogElement;
      const openSettingsBtn = document.getElementById("openSettingsBtn") as HTMLButtonElement;
      const settingsForm = document.getElementById("settingsForm") as HTMLFormElement;
      const settingsSubmitBtn = document.getElementById("settingsSubmitBtn") as HTMLButtonElement;
      const settingsErrorAlert = document.getElementById("settingsErrorAlert") as HTMLDivElement;

      const inputSzamlazzHuKey = document.getElementById("set_szamlazz_hu_api_key") as HTMLInputElement;
      const inputNavUser = document.getElementById("set_nav_technical_user") as HTMLInputElement;
      const inputNavPass = document.getElementById("set_nav_technical_password") as HTMLInputElement;
      const inputNavSign = document.getElementById("set_nav_sign_key") as HTMLInputElement;
      const inputNavExchange = document.getElementById("set_nav_exchange_key") as HTMLInputElement;

      openSettingsBtn?.addEventListener("click", async () => {
        if (!authToken) return;
        
        try {
          const res = await fetch(`${API_BASE}/api/settings`, {
            headers: { Authorization: `Bearer ${authToken}` },
          });
          const data = await res.json();
          
          if (res.ok && data.success) {
            inputSzamlazzHuKey.value = data.settings.szamlazzHuApiKey || '';
            inputNavUser.value = data.settings.navTechnicalUser || '';
            inputNavSign.value = data.settings.navSignKey || '';
            inputNavExchange.value = data.settings.navExchangeKey || '';
            inputNavPass.value = ''; // Nem jön át a backendről a jelszó
            
            settingsErrorAlert.classList.add("hidden");
            settingsModal.showModal();
          } else {
            showToast("Hiba a beállítások betöltésekor", "error");
          }
        } catch (err) {
          showToast("Nem sikerült kapcsolódni a szerverhez.", "error");
        }
      });

      settingsForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        settingsSubmitBtn.disabled = true;
        settingsErrorAlert.classList.add("hidden");

        const payload = {
          szamlazzHuApiKey: inputSzamlazzHuKey.value,
          navTechnicalUser: inputNavUser.value,
          navTechnicalPassword: inputNavPass.value || undefined, // csak ha beírták, akkor frissül
          navSignKey: inputNavSign.value,
          navExchangeKey: inputNavExchange.value
        };

        try {
          const res = await fetch(`${API_BASE}/api/settings`, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Authorization: `Bearer ${authToken}`,
