FROM node:22-slim AS builder

WORKDIR /app

# Függőségek másolása a backendből
COPY backend/package*.json ./backend/
WORKDIR /app/backend
RUN npm install

# Kódok másolása (backend és shared mappa is a helyére kerül)
WORKDIR /app
COPY shared ./shared
COPY backend ./backend

# Build futtatása a backend mappában
WORKDIR /app/backend
RUN npm run build

# Éles futtató környezet
FROM node:22-slim AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

COPY --from=builder /app/backend/package*.json ./
RUN npm install --omit=dev

COPY --from=builder /app/backend/dist ./dist
COPY --from=builder /app/shared ../shared

EXPOSE 3000

CMD ["npm", "start"]