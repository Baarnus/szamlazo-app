      // ==========================================
      // 🎙️ HANGALAPÚ DIKTÁLÁS (Web Speech API)
      // ==========================================

      const voiceBtn = document.getElementById("voiceBtn") as HTMLButtonElement | null;
      const voiceStatus = document.getElementById("voiceStatus") as HTMLDivElement | null;
      const voiceStatusText = document.getElementById("voiceStatusText") as HTMLSpanElement | null;

      // Böngésző támogatás ellenőrzése — ha NEM támogatott, elrejtjük a gombot
      const SpeechRecognitionAPI =
        (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;

      const voiceNotSupported = document.getElementById("voiceNotSupported") as HTMLDivElement | null;

      if (!SpeechRecognitionAPI) {
        voiceBtn?.classList.add("hidden");
        // Tájékoztató üzenet Firefox / nem támogatott böngészőkön
        voiceNotSupported?.classList.remove("hidden");
        voiceNotSupported?.classList.add("flex");
      }

      if (SpeechRecognitionAPI && voiceBtn) {

        let recognition: any = null;
        let isListening = false;

        let wasLastPromptVoice = false;

        function startListening() {
          if (isListening) {
            recognition?.stop();
            return;
          }

          recognition = new SpeechRecognitionAPI();
          recognition.lang = "hu-HU";
          recognition.continuous = false;
          recognition.interimResults = true;

          let finalTranscript = "";

          recognition.onstart = () => {
            isListening = true;
            // Pulsing piros animáció a gomb megnyomásakor
            voiceBtn!.classList.add("btn-error", "text-white");
            voiceBtn!.classList.remove("btn-ghost", "text-primary");
            voiceStatus!.classList.remove("hidden");
            voiceStatus!.classList.add("flex");
            voiceStatusText!.textContent = "Figyelek… (Befejezéshez kattints mégegyszer)";
          };

          recognition.onresult = (event: any) => {
            let interim = "";
            for (let i = event.resultIndex; i < event.results.length; i++) {
              const t = event.results[i][0].transcript;
              if (event.results[i].isFinal) {
                finalTranscript += t;
              } else {
                interim += t;
              }
            }
            // Valós idejű megjelenítés: az aktuális ideiglenes szöveg is látható
            const current = textPromptInput.value;
            // Csak az interim-et mutatjuk zárójelben
            textPromptInput.value = finalTranscript || current;
            if (interim) {
              voiceStatusText!.textContent = `„${interim}"`;
            }
          };

          recognition.onerror = (event: any) => {
            const msgs: Record<string, string> = {
              "not-allowed": "Mikrofon-hozzáférés megtagadva. Engedélyezd a böngészőben!",
              "no-speech": "Nem hallottam semmit. Próbáld újra!",
              "audio-capture": "Nem található mikrofon az eszközön.",
              "network": "Hálózati hiba az átírás során.",
            };
            showToast(msgs[event.error] || `Hang felismerési hiba: ${event.error}`, "error");
          };

          recognition.onend = () => {
            isListening = false;
            voiceBtn!.classList.remove("btn-error", "text-white");
            voiceBtn!.classList.add("btn-ghost", "text-primary");
            voiceStatus!.classList.add("hidden");
            voiceStatus!.classList.remove("flex");
            voiceStatusText!.textContent = "Figyelek…";

            // Ha van végleges szöveg, beletesszük a textareába és bejelöljük, hogy hangüzenet volt
            if (finalTranscript.trim()) {
              wasLastPromptVoice = true;
              const existing = textPromptInput.value.trim();
              textPromptInput.value = existing
                ? existing + " " + finalTranscript.trim()
                : finalTranscript.trim();
              textPromptInput.focus();
              showToast("🎙️ Hangüzenet sikeresen rögzítve szövegként!", "info");
            }
          };

          recognition.start();
        }

        voiceBtn.addEventListener("click", () => {
          if (isListening) {
            recognition?.stop();
          } else {
            startListening();
          }
        });
      }

      // ==========================================
      // 🧠 OKOS PARTNER AUTOCOMPLETE
      // ==========================================

      const partnerSuggestions = document.getElementById("partnerSuggestions") as HTMLDivElement | null;
      const partnerList = document.getElementById("partnerList") as HTMLUListElement | null;

      let partnerDebounceTimer: ReturnType<typeof setTimeout> | null = null;

      function closePartnerDropdown() {
        partnerSuggestions?.classList.add("hidden");
        if (partnerList) partnerList.innerHTML = "";
      }

      async function fetchPartnerSuggestions(query: string) {
        if (!authToken || query.length < 2) {
          closePartnerDropdown();
          return;
        }

        try {
          const res = await fetch(
            `${API_BASE}/api/partners/suggest?q=${encodeURIComponent(query)}`,
            { headers: { Authorization: `Bearer ${authToken}` } }
          );
          if (!res.ok) return;
          const data = await res.json();
          const partners: string[] = data.partners || [];

          if (partners.length === 0) {
            closePartnerDropdown();
            return;
          }

          // Dropdown feltöltése
          if (partnerList) partnerList.innerHTML = "";
          for (const name of partners) {
            const li = document.createElement("li");
            // Kiemelés: a query-vel egyező rész bold
            const safeQuery = query.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
            const highlighted = name.replace(
              new RegExp(`(${safeQuery})`, "gi"),
              '<mark class="bg-primary/20 text-primary rounded px-0.5">$1</mark>'
            );
            li.innerHTML = `<a class="text-sm py-1 px-2 rounded hover:bg-base-200 cursor-pointer partner-item">${highlighted}</a>`;

            // Kattintáskor beillesztjük a nevet a textarea-ba
            li.addEventListener("mousedown", (e) => {
              e.preventDefault(); // Megakadályozzuk a textarea blur-t
              // Lecseréljük az utolsó szót (amin a query alapul) a teljes névre
              const val = textPromptInput.value;
              const lastSpace = val.lastIndexOf(" ");
              const prefix = lastSpace >= 0 ? val.substring(0, lastSpace + 1) : "";
              textPromptInput.value = prefix + name;
              textPromptInput.focus();
              closePartnerDropdown();
            });

            partnerList?.appendChild(li);
          }

          partnerSuggestions?.classList.remove("hidden");
        } catch {
          // Csendben elnyeljük — a partner autocomplete nem kritikus funkció
        }
      }

      textPromptInput.addEventListener("input", () => {
        if (partnerDebounceTimer) clearTimeout(partnerDebounceTimer);

        const val = textPromptInput.value;
        // Az utolsó "szó" (szóköz utáni rész) alapján keresünk
        const lastWord = val.split(/\s+/).pop() || "";

        if (lastWord.length < 2) {
          closePartnerDropdown();
          return;
        }

        partnerDebounceTimer = setTimeout(() => {
          fetchPartnerSuggestions(lastWord);
        }, 300);
      });

      // Dropdown bezárása ha a felhasználó máshova kattint
      document.addEventListener("click", (e) => {
        const target = e.target as Node;
        if (
          !partnerSuggestions?.contains(target) &&
          !textPromptInput.contains(target)
        ) {
          closePartnerDropdown();
        }
      });

      // ESC gombra is bezárjuk
      textPromptInput.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closePartnerDropdown();
      });

      // ==========================================
      // FELDOLGOZÁS INDÍTÁSA (SSE STREAMING)
      // ==========================================

      processBtn.addEventListener("click", async () => {
        if (!authToken) {
          setAuthModalMode("login");
          authModal.showModal();
          return;
        }

        const items: ImageInputItem[] = [];

        if (currentMode === "upload") {
          if (selectedFiles.length === 0) {
            showToast("Válassz ki vagy fotózz be legalább egy képet!", "info");
            return;
          }

          for (const file of selectedFiles) {
            const base64 = await fileToBase64(file);
            items.push({ type: "base64", data: base64, mimeType: file.type });
          }
        } else if (currentMode === "url") {
          const urls = urlInput.value
            .split("\n")
            .map((u) => u.trim())
            .filter((u) => u.length > 0);

          if (urls.length === 0) {
            showToast("Adj meg legalább egy kép URL-t!", "info");
            return;
          }
          if (urls.length > 10) {
            showToast("Egyszerre maximum 10 URL-t adhatsz meg!", "info");
            return;
          }

          for (const u of urls) {
            items.push({ type: "url", data: u });
          }
        } else if (currentMode === "text") {
          const textPrompt = textPromptInput.value.trim();
          if (!textPrompt) {
            showToast("Írd be a szöveges utasítást!", "info");
            return;
          }

          processBtn.disabled = true;
          processBtn.innerHTML = '<span class="loading loading-spinner"></span> AI Feldolgozás...';

          try {
            const res = await fetch(`${API_BASE}/api/invoices/parse-text`, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                Authorization: `Bearer ${authToken}`,
              },
              body: JSON.stringify({
                textPrompt,
                isVoicePrompt: typeof wasLastPromptVoice !== "undefined" ? wasLastPromptVoice : false
              }),
            });
            const data = await res.json();
            
            if (!res.ok || !data.success) {
              throw new Error(data.error || "Hiba a feldolgozás során");
            }

            if (typeof wasLastPromptVoice !== "undefined") {
              wasLastPromptVoice = false;
            }

            // Ha kész van, kártya létrehozása (több számla is lehet egy promptból!)
            const newResults = data.results || (data.result ? [data.result] : []);
            lastProcessedResults = [...newResults, ...lastProcessedResults];
            
            const newMocks = newResults.map(() => ({ type: "url", data: "" }));
            inputItemsCache = [...newMocks, ...inputItemsCache]; // mock cache to keep indexes matching
            
            checkCurrentSession(); // refresh credits
            renderResultsCards();
            showToast("Sikeres szöveg-értelmezés!", "success");
            textPromptInput.value = "";
            exportCsvBtn.classList.remove("hidden"); exportRlbBtn.classList.remove("hidden");

          } catch (err: any) {
            showToast(err.message, "error");
          } finally {
            processBtn.disabled = false;
            processBtn.textContent = "Feldolgozás Indítása";
          }
          return; // A szöveges mód végzett, ne menjen tovább a fájlos feldolgozóra!
        }

        inputItemsCache = items;

        activityLog.innerHTML = "";
        logBoxContainer.classList.remove("hidden");
        logSpeedInfo.textContent = "";

        processBtn.disabled = true;
        processBtn.innerHTML =
          '<span class="loading loading-spinner"></span> Feldolgozás...';

        statusAlert.className =
          "alert alert-info shadow-lg flex flex-col md:flex-row justify-between items-center gap-4";
        statusMessage.textContent = `Feldolgozás elindítva (0 / ${items.length})...`;
        progressBar.classList.remove("hidden");
        progressBar.value = 0;
        progressBar.max = items.length;
        progressPercent.textContent = "0%";
        exportCsvBtn.classList.add("hidden"); exportRlbBtn.classList.add("hidden");

        try {
          const response = await fetch(`${API_BASE}/api/parse-batch-stream`, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Authorization: `Bearer ${authToken}`,
            },
            body: JSON.stringify({ items }),
          });

          if (!response.ok || !response.body) {
            const errJson = await response.json().catch(() => ({}));
            throw new Error(
              errJson.error || "Hiba történt a streaming indításakor.",
            );
          }

          const reader = response.body.getReader();
          const decoder = new TextDecoder("utf-8");
          let buffer = "";
          let totalCount = items.length;
          let completedCount = 0;

          while (true) {
            const { done, value } = await reader.read();
            if (done) break;

            buffer += decoder.decode(value, { stream: true });
            const lines = buffer.split("\n\n");
            buffer = lines.pop() || "";

            for (const chunk of lines) {
              if (!chunk.trim()) continue;

              const eventMatch = chunk.match(/^event:\s*(.+)$/m);
              const dataMatch = chunk.match(/^data:\s*(.+)$/m);

              const eventType = eventMatch ? eventMatch[1]?.trim() : "message";
              const rawData = dataMatch ? dataMatch[1]?.trim() : "";

              if (eventType === "start" && rawData) {
                const parsed = JSON.parse(rawData);
                totalCount = parsed.total || items.length;
                progressBar.max = totalCount;
                if (parsed.remainingCredits !== undefined) {
                  userCreditsDisplay.textContent = String(
                    parsed.remainingCredits,
                  );
                }
              } else if (eventType === "invoice-parsed" && rawData) {
                const invoiceResult = JSON.parse(rawData);
                lastProcessedResults.unshift(invoiceResult);

                renderResultsCards();

                completedCount++;
                progressBar.value = completedCount;
                const percent = Math.round((completedCount / totalCount) * 100);
                progressPercent.textContent = `${percent}%`;
                statusMessage.textContent = `Feldolgozás alatt: ${completedCount} / ${totalCount} számla kész...`;

                const logRow = document.createElement("div");
                const isOk = invoiceResult.success;
                const partner =
                  invoiceResult.data?.kiallito_neve || invoiceResult.source;
                const orderNum = invoiceResult.finishedOrder || completedCount;
                const time = invoiceResult.durationSeconds
                  ? `${invoiceResult.durationSeconds}s`
                  : "";

                logRow.className = `flex justify-between items-center py-0.5 border-b border-base-content/5 last:border-0 ${isOk ? "text-success" : "text-error"}`;
                logRow.innerHTML = `
                    <span><b>#${orderNum}.</b> ${isOk ? "✓" : "✕"} ${partner}</span>
                    <span class="text-[10px] text-base-content/50">${time}</span>
                  `;
                activityLog.appendChild(logRow);
                activityLog.scrollTop = activityLog.scrollHeight;
              } else if (eventType === "done") {
                const doneData = rawData ? JSON.parse(rawData) : {};
                statusAlert.className =
                  "alert alert-success shadow-lg flex flex-col md:flex-row justify-between items-center gap-4";
                statusMessage.textContent = `Mind a(z) ${completedCount} számla feldolgozva és elmentve!`;
                if (doneData.totalDuration)
                  logSpeedInfo.textContent = `Összidő: ${doneData.totalDuration} mp`;
                if (doneData.remainingCredits !== undefined) {
                  userCreditsDisplay.textContent = String(
                    doneData.remainingCredits,
                  );
                }
                progressBar.classList.add("hidden");
                progressPercent.textContent = "";
                exportCsvBtn.classList.remove("hidden"); exportRlbBtn.classList.remove("hidden");
              }
            }
          }
        } catch (err: any) {
          statusAlert.className = "alert alert-error shadow-lg flex";
          statusMessage.textContent = err.message || "Hálózati hiba.";
          progressBar.classList.add("hidden");
          progressPercent.textContent = "";
        } finally {
          processBtn.disabled = false;
          processBtn.textContent = "Feldolgozás Indítása";
        }
      });

      // Induláskori munkamenet vizsgálat
      checkCurrentSession();
    </script>
    
    <!-- CookieConsent V3 JS -->
    <script type="module" is:inline>
      import 'https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@v3.0.0/dist/cookieconsent.umd.js';
      
      const toggleScroll = (isShown) => {
        document.documentElement.style.overflow = isShown ? 'hidden' : '';
      };

      CookieConsent.run({
        guiOptions: {
          consentModal: {
            layout: "box",
            position: "bottom left",
            equalWeightButtons: true,
            flipButtons: false
          },
          preferencesModal: {
            layout: "box",
            position: "right",
            equalWeightButtons: true,
            flipButtons: false
          }
        },
        categories: {
          necessary: { readOnly: true },
          analytics: {},
          marketing: {}
        },
        language: {
          default: "hu",
          autoDetect: "browser",
          translations: {
            hu: {
              consentModal: {
                title: "Az oldal sütiket használ",
                description: "Weboldalunk sütiket használ a működés biztosítása, az analitika és a célzott marketing érdekében.",
                acceptAllBtn: "Mind elfogadása",
                acceptNecessaryBtn: "Csak szükségesek",
                showPreferencesBtn: "Testreszabás"
              },
              preferencesModal: {
                title: "Süti (Cookie) Beállítások",
                acceptAllBtn: "Mind elfogadása",
                acceptNecessaryBtn: "Csak szükségesek",
                savePreferencesBtn: "Beállítások mentése",
                closeIconLabel: "Bezárás",
                sections: [
                  {
                    title: "Süti Használat",
                    description: "Itt testreszabhatja a sütik kategóriáit."
                  },
                  {
                    title: "Szigorúan Szükséges Sütik <span class=\"pm__badge\">Mindig aktív</span>",
                    description: "Ezek a sütik a weboldal alapvető működéséhez szükségesek, például a bejelentkezéshez (localStorage).",
                    linkedCategory: "necessary"
                  },
                  {
                    title: "Analitikai Sütik",
                    description: "Ezek a sütik segítenek nekünk megérteni, hogyan használják a látogatók a weboldalt.",
                    linkedCategory: "analytics"
                  },
                  {
                    title: "Marketing Sütik",
                    description: "Ezek a sütik hirdetések személyre szabásához szükségesek (Google Ads).",
                    linkedCategory: "marketing"
                  }
                ]
              }
            }
          }
        },
        onFirstConsent: ({ cookie }) => updateGtmConsent(cookie.categories),
        onConsent: ({ cookie }) => updateGtmConsent(cookie.categories),
        onChange: ({ changedCategories, cookie }) => updateGtmConsent(cookie.categories),
        onModalShow: () => toggleScroll(true),
        onModalHide: () => toggleScroll(false)
      });
      
      function updateGtmConsent(categories) {
          const analyticsConsent = categories.includes('analytics') ? 'granted' : 'denied';
          const marketingConsent = categories.includes('marketing') ? 'granted' : 'denied';
          
          if(typeof window.gtag === 'function') {
            window.gtag('consent', 'update', {
                'analytics_storage': analyticsConsent,
                'ad_storage': marketingConsent,
                'ad_user_data': marketingConsent,
                'ad_personalization': marketingConsent
            });
          }
      }
    </script>
  </body>
</html>


