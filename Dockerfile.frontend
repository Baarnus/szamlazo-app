FROM node:22-slim

WORKDIR /app

# Függőségek és forrásfájlok másolása (frontend és shared mappa)
COPY shared ./shared
RUN cd ./shared && npm install --include=dev

COPY frontend/package*.json ./frontend/
WORKDIR /app/frontend
RUN npm install --include=dev

COPY frontend ./

# Astro éles build futtatása
RUN npm run build

# Port és környezeti változók
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=4321

EXPOSE 4321

# Jogosultságok átadása a beépített node felhasználónak a rootként futás megelőzésére
RUN chown -R node:node /app

USER node

# Indítás az Astro preview szerverével a megadott porton és hoston
CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "4321"]