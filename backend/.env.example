# ==============================================================================
# SZÁMLA AI - BACKEND KÖRNYEZETI VÁLTOZÓK (.env.example)
# ==============================================================================

# Node környezet (development / production / test)
NODE_ENV=development

# Backend HTTP szerver port
PORT=3000

# PostgreSQL adatbázis kapcsolat
DATABASE_URL=postgres://postgres:password@localhost:5432/szamlazo

# Google Gemini AI beállítások
# A támogatott és optimalizált modell: gemini-3.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# AES-256-GCM Titkosítási kulcs (KÖTELEZŐ ÉLES KÖRNYEZETBEN!)
# 32 bájtos hex string (pl. openssl rand -hex 32)
# Ezzel titkosítódnak a NAV és Számlázz.hu API kulcsok az adatbázisban.
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# JWT Hitelesítési titok
JWT_SECRET=your_jwt_secret_key_here

# S3 / MinIO objektumtároló beállítások (számlaképek tárolásához)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=invoices
# Ha az S3 belső hálózaton fut, a kliens felé kiadott presigned linkek hosztját erre cseréli:
S3_PUBLIC_URL=http://localhost:9000

# Stripe fizetési integráció
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Stripe Webhook aláírás-ellenőrzés (opcionális helyi teszthez, élesben kötelező)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# E-mail küldés (Resend API)
RESEND_API_KEY=re_your_resend_api_key
# Jelszó-visszaállító levelek feladó címe
MAIL_FROM=Számla AI <info@szamlazzjol.hu>

# Frontend elérési URL (jelszó-visszaállító linkek bázis címe)
FRONTEND_URL=http://localhost:4321

# CORS engedélyezett origin lista (vesszővel elválasztva több cím esetén)
ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
