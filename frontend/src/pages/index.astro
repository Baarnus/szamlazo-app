      function openEditModal(index: number) {
        legalLiabilityCheckbox.checked = false;
        issueSzamlazzHuBtn.disabled = true;
        
        const item = lastProcessedResults[index];
        if (!item || !item.data) return;

        activeEditIndex = index;
        currentEditingData = JSON.parse(JSON.stringify(item.data));

        const inputItem = inputItemsCache[index];
        let imageSrc = "";
        let isTextPrompt = false;

        if (item.source && item.source.startsWith("Szöveges prompt:")) {
          isTextPrompt = true;
          modalImageLabel.textContent = "Felhasználói prompt utasítás";
          modalTextPrompt.textContent = item.source.replace("Szöveges prompt: ", "");
          modalTextPrompt.classList.remove("hidden");
          modalImage.classList.add("hidden");
          modalImageLink.classList.add("hidden");
        } else {
          isTextPrompt = false;
          modalImageLabel.textContent = "Eredeti számlakép";
          modalTextPrompt.classList.add("hidden");
          modalImage.classList.remove("hidden");
          modalImageLink.classList.remove("hidden");
          
          if (inputItem) {
            imageSrc =
              inputItem.type === "base64"
                ? inputItem.data.startsWith("data:")
                  ? inputItem.data
                  : `data:${inputItem.mimeType || "image/jpeg"};base64,${inputItem.data}`
                : inputItem.data;
          }

          modalImage.src = imageSrc;
          modalImageLink.href = imageSrc;
        }

        editKiallitoNeve.value = currentEditingData?.kiallito_neve || "";
        editKiallitoAdoszam.value = currentEditingData?.kiallito_adoszam || "";
        editSzamlaszam.value = currentEditingData?.szamlaszam || "";
        editVevoNeve.value = currentEditingData?.vevo_neve || "";
        editKeltDatum.value = currentEditingData?.kelt_datum || "";
        editFizetesiHatarido.value =
          currentEditingData?.fizetesi_hatarido || "";
        editOrszag.value = currentEditingData?.kiallito_orszag || "";

        const currentCur = (currentEditingData?.penznem || "HUF")
          .toUpperCase()
          .trim();
        const isSupported = SUPPORTED_CURRENCIES.some(
          (c) => c.code === currentCur,
        );
        const dynamicExisting = Array.from(editPenznem.options).some(
          (opt) => opt.value === currentCur,
        );

        if (!isSupported && !dynamicExisting && currentCur) {
          const newOpt = document.createElement("option");
          newOpt.value = currentCur;
          newOpt.textContent = `${currentCur} (AI talált)`;
          editPenznem.appendChild(newOpt);
        }
        editPenznem.value = currentCur;

        renderEditItems();
        recalculateModalTotals();
        editModal.showModal();
      }

      function renderEditItems() {
        if (!currentEditingData) return;
        editItemsTbody.innerHTML = "";

        const cur = editPenznem.value || "HUF";

        (currentEditingData.tetelek || []).forEach((t, i) => {
          const tr = document.createElement("tr");
          tr.innerHTML = `
              <td>
                <input type="text" class="input input-xs input-bordered w-full item-name" data-index="${i}" value="${t.megnevezes || ""}" />
              </td>
              <td>
                <input type="number" step="any" class="input input-xs input-bordered w-full text-right item-qty" data-index="${i}" value="${t.mennyiseg || 1}" />
              </td>
              <td>
                <input type="number" step="any" class="input input-xs input-bordered w-full text-right item-unit" data-index="${i}" value="${t.egysegar || 0}" />
              </td>
              <td>
                <input type="number" step="any" class="input input-xs input-bordered w-full text-right item-vat-rate" data-index="${i}" value="${t.afa_szazalek || 0}" />
              </td>
              <td class="text-right font-medium text-xs item-net-display">${formatCurrency(t.netto_ar, cur)}</td>
              <td class="text-right text-xs text-base-content/70 item-vat-display">${formatCurrency(t.afa_ertek || 0, cur)}</td>
              <td class="text-right font-bold text-xs item-gross-display">${formatCurrency(t.brutto_ar, cur)}</td>
              <td class="text-center">
                <button type="button" class="btn btn-ghost btn-xs text-error btn-circle remove-item-btn" data-index="${i}">&times;</button>
              </td>
            `;
          editItemsTbody.appendChild(tr);
        });

        editItemsTbody
          .querySelectorAll(".item-qty, .item-unit, .item-vat-rate")
          .forEach((input) => {
            input.addEventListener("input", (e) => {
              const idx = Number(
                (e.target as HTMLElement).getAttribute("data-index"),
              );
              const row = (e.target as HTMLElement).closest("tr");
              if (
                !row ||
                !currentEditingData ||
                !currentEditingData.tetelek[idx]
              )
                return;

              const qty =
                parseFloat(
                  (row.querySelector(".item-qty") as HTMLInputElement).value,
                ) || 0;
              const unit =
                parseFloat(
                  (row.querySelector(".item-unit") as HTMLInputElement).value,
                ) || 0;
              const vatRate =
                parseFloat(
                  (row.querySelector(".item-vat-rate") as HTMLInputElement)
                    .value,
                ) || 0;

              const net = qty * unit;
              const vat = net * (vatRate / 100);
              const gross = net + vat;

              currentEditingData.tetelek[idx].mennyiseg = qty;
              currentEditingData.tetelek[idx].egysegar = unit;
              currentEditingData.tetelek[idx].afa_szazalek = vatRate;
              currentEditingData.tetelek[idx].netto_ar = net;
              currentEditingData.tetelek[idx].afa_ertek = vat;
              currentEditingData.tetelek[idx].brutto_ar = gross;

              const selectedCur = editPenznem.value || "HUF";
              (
                row.querySelector(".item-net-display") as HTMLElement
              ).textContent = formatCurrency(net, selectedCur);
              (
                row.querySelector(".item-vat-display") as HTMLElement
              ).textContent = formatCurrency(vat, selectedCur);
              (
                row.querySelector(".item-gross-display") as HTMLElement
              ).textContent = formatCurrency(gross, selectedCur);

              recalculateModalTotals();
            });
          });

        editItemsTbody.querySelectorAll(".item-name").forEach((input) => {
          input.addEventListener("input", (e) => {
            const idx = Number(
              (e.target as HTMLElement).getAttribute("data-index"),
            );
            if (currentEditingData && currentEditingData.tetelek[idx]) {
              currentEditingData.tetelek[idx].megnevezes = (
                e.target as HTMLInputElement
              ).value;
            }
          });
        });

        editItemsTbody.querySelectorAll(".remove-item-btn").forEach((btn) => {
          btn.addEventListener("click", (e) => {
            const idx = Number(
              (e.target as HTMLElement).getAttribute("data-index"),
            );
            if (currentEditingData) {
              currentEditingData.tetelek.splice(idx, 1);
              renderEditItems();
              recalculateModalTotals();
            }
          });
        });
      }

      addItemBtn.addEventListener("click", () => {
        if (!currentEditingData) return;
        currentEditingData.tetelek = currentEditingData.tetelek || [];
        currentEditingData.tetelek.push({
          megnevezes: "Új tétel",
          mennyiseg: 1,
          egysegar: 0,
          afa_szazalek: 27,
          netto_ar: 0,
          afa_ertek: 0,
          brutto_ar: 0,
        });
        renderEditItems();
        recalculateModalTotals();
      });

      function recalculateModalTotals() {
        if (!currentEditingData) return;

        const cur = editPenznem.value || "HUF";
        let sumNetto = 0;
        let sumAfa = 0;
        let sumBrutto = 0;

        (currentEditingData.tetelek || []).forEach((t) => {
          sumNetto += Number(t.netto_ar || 0);
          sumAfa += Number(t.afa_ertek || 0);
          sumBrutto += Number(t.brutto_ar || 0);
        });

        currentEditingData.vegosszeg_netto = sumNetto;
        currentEditingData.vegosszeg_afa = sumAfa;
        currentEditingData.vegosszeg_brutto = sumBrutto;
        currentEditingData.penznem = cur;

        displayNetto.textContent = formatCurrency(sumNetto, cur);
        displayAfa.textContent = formatCurrency(sumAfa, cur);
        displayBrutto.textContent = formatCurrency(sumBrutto, cur);

        const mathValid = Math.abs(sumNetto + sumAfa - sumBrutto) <= 1.0;
        if (mathValid) {
          modalValidBadge.className = "badge badge-success";
          modalValidBadge.textContent = "✓ Valid";
          modalWarningBox.classList.add("hidden");
        } else {
          modalValidBadge.className = "badge badge-warning";
          modalValidBadge.textContent = "⚠ Eltérés";
          modalWarningBox.textContent = `A számított nettó (${sumNetto.toFixed(2)}) és áfa (${sumAfa.toFixed(2)}) nem egyezik a bruttóval (${sumBrutto.toFixed(2)}).`;
          modalWarningBox.classList.remove("hidden");
        }
      }

      editPenznem.addEventListener("change", () => {
        if (currentEditingData) currentEditingData.penznem = editPenznem.value;
        renderEditItems();
        recalculateModalTotals();
      });

      // MÓDOSÍTÁS MENTÉSE
      saveChangesBtn.addEventListener("click", async () => {
        if (activeEditIndex === -1 || !currentEditingData) return;

        currentEditingData.kiallito_neve = editKiallitoNeve.value;
        currentEditingData.kiallito_adoszam = editKiallitoAdoszam.value;
        currentEditingData.szamlaszam = editSzamlaszam.value;
        currentEditingData.vevo_neve = editVevoNeve.value;
        currentEditingData.kelt_datum = editKeltDatum.value;
        currentEditingData.fizetesi_hatarido = editFizetesiHatarido.value;
        currentEditingData.penznem = editPenznem.value.toUpperCase();
        currentEditingData.kiallito_orszag = editOrszag.value.toUpperCase();

        const currentResult = lastProcessedResults[activeEditIndex];
        if (currentResult) {
          currentResult.data = currentEditingData;
          currentResult.isValid = true;
          currentResult.errors = [];

          if (currentResult.dbId && authToken) {
            try {
              await fetch(`${API_BASE}/api/invoices/${currentResult.dbId}`, {
                method: "PATCH",
                headers: {
                  "Content-Type": "application/json",
                  Authorization: `Bearer ${authToken}`,
                },
                body: JSON.stringify({
                  data: currentEditingData,
                  isValid: true,
                }),
              });
            } catch (err) {
              console.error("Hiba a számla adatbázis frissítésekor:", err);
            }
          }
        }

        renderResultsCards();
        editModal.close();
      });

      // E-SZÁMLA KIÁLLÍTÁSA (Számlázz.hu)
      issueSzamlazzHuBtn.addEventListener("click", async () => {
        if (activeEditIndex === -1 || !currentEditingData) return;
        const currentResult = lastProcessedResults[activeEditIndex];
        if (!currentResult || !currentResult.dbId) {
          showToast("Kérjük, először mentsd el a felhőbe a módosításokat!", "info");
          return;
        }

        // 1. Megpróbáljuk elküldeni az E-számla készítés hívást
        issueSzamlazzHuBtn.disabled = true;
        const originalText = issueSzamlazzHuBtn.innerHTML;
        issueSzamlazzHuBtn.innerHTML = '<span class="loading loading-spinner loading-xs"></span> Küldés...';

        try {
          const res = await fetch(`${API_BASE}/api/szamlazz/issue/${currentResult.dbId}`, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Authorization: `Bearer ${authToken}`,
            },
            body: JSON.stringify({
              data: currentEditingData // átadjuk a frissített form-ot, bár opcionális, a backend Zoddal parsolja
            }),
          });
          const data = await res.json();

          if (res.ok && data.success) {
            showToast(`Sikeres e-számla kiállítás! Számlaszám: ${data.invoiceNumber}`, "success");
            
            // Ha van letölthető PDF
            if (data.pdfBase64) {
              const linkSource = `data:application/pdf;base64,${data.pdfBase64}`;
              const downloadLink = document.createElement("a");
              downloadLink.href = linkSource;
              downloadLink.download = `${data.invoiceNumber || 'eszamla'}.pdf`;
              downloadLink.click();
            }

            editModal.close();
          } else {
            showToast(data.error || "Ismeretlen hiba a kiállítás során.", "error");
          }
        } catch (err) {
          showToast("Hálózati hiba a Számlázz.hu hívásakor.", "error");
        } finally {
          issueSzamlazzHuBtn.disabled = !legalLiabilityCheckbox.checked;
          issueSzamlazzHuBtn.innerHTML = originalText;
        }
      });

      cancelModalBtn.addEventListener("click", () => editModal.close());

      // ==========================================
      // KÁRTYÁK KIRAJZOLÁSA
      // ==========================================

      function createCardElement(
        item: SingleInvoiceResult & { dbId?: string },
        index: number,
      ): HTMLElement {
        const card = document.createElement("div");
        card.id = `card-item-${index}`;
        card.className =
          "card bg-base-100 shadow-xl border border-base-200 hover:border-primary/40 transition-all duration-300";

        if (!item.success || !item.data) {
          card.innerHTML = `
              <div class="card-body">
                <div class="flex justify-between items-center">
                  <h3 class="font-bold text-error">Hiba: ${item.source}</h3>
                  <span class="badge badge-error">Sikertelen</span>
                </div>
                <p class="text-xs text-base-content/70 mt-2">${item.errors.join(", ")}</p>
              </div>
            `;
        } else {
          const d = item.data;
          const currency = d.penznem || "HUF";

          const rows = (d.tetelek || [])
            .map((t) => {
              const afaErtek =
                t.afa_ertek !== undefined && t.afa_ertek !== null
                  ? t.afa_ertek
                  : Number(t.brutto_ar || 0) - Number(t.netto_ar || 0);

              return `
                  <tr>
                    <td class="font-medium">${t.megnevezes || "-"}</td>
                    <td class="text-right">${t.mennyiseg}</td>
                    <td class="text-right">${formatCurrency(t.egysegar, currency)}</td>
                    <td class="text-right"><span class="badge badge-ghost badge-sm">${t.afa_szazalek}%</span></td>
                    <td class="text-right">${formatCurrency(t.netto_ar, currency)}</td>
                    <td class="text-right text-base-content/70">${formatCurrency(afaErtek, currency)}</td>
                    <td class="text-right font-semibold">${formatCurrency(t.brutto_ar, currency)}</td>
                  </tr>
                `;
            })
            .join("");

          const errorAlert = !item.isValid
            ? `
                <div class="alert alert-warning text-xs p-2 rounded-lg mt-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-4 w-4" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                  <span><b>Figyelmeztetés:</b> ${item.errors.join(" | ")}</span>
                </div>
              `
            : "";

          card.innerHTML = `
              <div class="card-body space-y-4 p-4 md:p-6">
                <div class="flex flex-wrap justify-between items-center border-b border-base-200 pb-3 gap-2">
                  <div>
                    <h3 class="font-bold text-lg text-primary">
                      ${d.kiallito_neve || "Ismeretlen kiállító"}
                      ${d.kiallito_orszag ? `<span class="badge badge-sm badge-outline ml-1">${d.kiallito_orszag}</span>` : ""}
                    </h3>
                    <div class="text-xs text-base-content/60">
                      Számlaszám: <span class="font-mono font-semibold">${d.szamlaszam || "Nincs"}</span> 
                      ${d.kiallito_adoszam ? `| Adószám: ${d.kiallito_adoszam}` : ""}
                    </div>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="badge badge-accent font-bold">${currency}</span>
                    <span class="badge ${item.isValid ? "badge-success" : "badge-warning"}">
                      ${item.isValid ? "✓ Valid" : "⚠ Ellenőrizendő"}
                    </span>
                    <button type="button" class="btn btn-sm btn-outline btn-primary edit-card-btn ml-2" data-index="${index}">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                      </svg>
                      Ellenőrzés / Szerkesztés
                    </button>
                    ${item.dbId ? `
                    <button type="button" class="btn btn-sm btn-outline btn-error delete-card-btn" data-id="${item.dbId}" title="Törlés">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    </button>
                    ` : ''}
                  </div>
                </div>

                ${errorAlert}

                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3 text-xs bg-base-200/50 p-3 rounded-box">
                  <div><span class="text-base-content/50 block">Vevő:</span> <span class="font-medium">${d.vevo_neve || "-"}</span></div>
                  <div><span class="text-base-content/50 block">Kelt:</span> <span class="font-medium">${d.kelt_datum || "-"}</span></div>
                  <div><span class="text-base-content/50 block">Fiz. határidő:</span> <span class="font-medium">${d.fizetesi_hatarido || "-"}</span></div>
                  <div><span class="text-base-content/50 block">Nettó összesen:</span> <span class="font-medium">${formatCurrency(d.vegosszeg_netto, currency)}</span></div>
                  <div><span class="text-base-content/50 block">ÁFA összesen:</span> <span class="font-medium">${formatCurrency(d.vegosszeg_afa, currency)}</span></div>
                </div>

                <div class="flex justify-between items-center bg-base-200 px-4 py-2 rounded-lg">
                  <span class="text-sm font-semibold text-base-content/80">Fizetendő bruttó végösszeg:</span>
                  <span class="text-lg font-bold text-success">${formatCurrency(d.vegosszeg_brutto, currency)}</span>
                </div>

                <div class="overflow-x-auto border border-base-200 rounded-lg">
                  <table class="table table-xs table-zebra w-full">
                    <thead class="bg-base-200/60">
                      <tr>
                        <th>Tétel</th>
                        <th class="text-right">Mennyiség</th>
                        <th class="text-right">Egységár</th>
                        <th class="text-right">ÁFA %</th>
                        <th class="text-right">Nettó</th>
                        <th class="text-right">ÁFA érték</th>
                        <th class="text-right">Bruttó</th>
                      </tr>
                    </thead>
                    <tbody>${rows}</tbody>
                  </table>
                </div>
              </div>
            `;

          card
            .querySelector(".edit-card-btn")
            ?.addEventListener("click", () => {
              openEditModal(index);
            });

          card
            .querySelector(".delete-card-btn")
            ?.addEventListener("click", async (e) => {
              const btn = e.currentTarget as HTMLButtonElement;
              const dbId = btn.getAttribute("data-id");
              if (!dbId) return;

              if (confirm("Biztosan törölni szeretnéd ezt a számlát? (A módosítás nem visszavonható)")) {
                btn.disabled = true;
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<span class="loading loading-spinner loading-xs"></span>';
                try {
                  const res = await fetch(`${API_BASE}/api/invoices/${dbId}`, {
                    method: 'DELETE',
                    headers: { Authorization: `Bearer ${authToken}` }
                  });
                  const data = await res.json();
                  if (data.success) {
                    showToast("Számla sikeresen törölve.", "success");
                    // Eltávolítjuk a UI-ról
                    lastProcessedResults.splice(index, 1);
                    renderResultsCards();
                  } else {
                    showToast(data.error || "Hiba történt a törlés során.", "error");
                  }
                } catch (err) {
                  showToast("Hálózati hiba a törléskor.", "error");
                } finally {
                  btn.disabled = false;
                  btn.innerHTML = originalHtml;
                }
              }
            });
        }

        return card;
      }

      function renderResultsCards() {
        resultsWrapper.innerHTML = "";
        lastProcessedResults.forEach((item, i) => {
          resultsWrapper.appendChild(createCardElement(item, i));
        });
      }

      // ==========================================
      // CSV EXPORT
      // ==========================================

      async function triggerBackendCsvDownload() {
        if (!authToken) {
          setAuthModalMode("login");
          authModal.showModal();
          return;
        }

        exportCsvBtn.disabled = true;
        const originalContent = exportCsvBtn.innerHTML;
        exportCsvBtn.innerHTML =
          '<span class="loading loading-spinner loading-xs"></span> Letöltés...';

        try {
          const res = await fetch(`${API_BASE}/api/invoices/export/csv`, {
            headers: {
              Authorization: `Bearer ${authToken}`,
            },
          });

          if (!res.ok) {
            const errData = await res.json().catch(() => ({}));
            throw new Error(errData.error || "A CSV exportálása sikertelen.");
          }

          const blob = await res.blob();
          const url = window.URL.createObjectURL(blob);
          const a = document.createElement("a");
          a.href = url;
          a.download = `szamlak_export_${new Date().toISOString().slice(0, 10)}.csv`;
          document.body.appendChild(a);
          a.click();
          a.remove();
          window.URL.revokeObjectURL(url);
        } catch (err: any) {
          showToast(`Hiba a letöltés során: ${err.message}`, "error");
        } finally {
          exportCsvBtn.disabled = false;
          exportCsvBtn.innerHTML = originalContent;
        }
      }

      exportCsvBtn.addEventListener("click", triggerBackendCsvDownload);

      // ==========================================
      // FELDOLGOZÁS INDÍTÁSA (SSE STREAMING)
      // ==========================================

      processBtn.addEventListener("click", async () => {
        if (!authToken) {
          setAuthModalMode("login");
          authModal.showModal();
          return;
        }

        const items: ImageInputItem[] = [];

        if (currentMode === "upload") {
          if (selectedFiles.length === 0) {
            showToast("Válassz ki vagy fotózz be legalább egy képet!", "info");
            return;
          }

          for (const file of selectedFiles) {
            const base64 = await fileToBase64(file);
            items.push({ type: "base64", data: base64, mimeType: file.type });
          }
        } else if (currentMode === "url") {
          const urls = urlInput.value
            .split("\n")
            .map((u) => u.trim())
            .filter((u) => u.length > 0);

          if (urls.length === 0) {
            showToast("Adj meg legalább egy kép URL-t!", "info");
            return;
          }
          if (urls.length > 10) {
            showToast("Egyszerre maximum 10 URL-t adhatsz meg!", "info");
            return;
          }

          for (const u of urls) {
            items.push({ type: "url", data: u });
          }
        } else if (currentMode === "text") {
          const textPrompt = textPromptInput.value.trim();
          if (!textPrompt) {
            showToast("Írd be a szöveges utasítást!", "info");
            return;
          }

          processBtn.disabled = true;
          processBtn.innerHTML = '<span class="loading loading-spinner"></span> AI Feldolgozás...';

          try {
            const res = await fetch(`${API_BASE}/api/invoices/parse-text`, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                Authorization: `Bearer ${authToken}`,
              },
              body: JSON.stringify({ textPrompt }),
            });
            const data = await res.json();
            
            if (!res.ok || !data.success) {
              throw new Error(data.error || "Hiba a feldolgozás során");
            }

            // Ha kész van, kártya létrehozása
            lastProcessedResults = [data.result, ...lastProcessedResults];
            inputItemsCache = [{ type: "url", data: "" }, ...inputItemsCache]; // mock cache to keep indexes matching
            
            checkCurrentSession(); // refresh credits
            renderResultsCards();
            showToast("Sikeres szöveg-értelmezés!", "success");
            textPromptInput.value = "";
            exportCsvBtn.classList.remove("hidden");

          } catch (err: any) {
            showToast(err.message, "error");
          } finally {
            processBtn.disabled = false;
            processBtn.textContent = "Feldolgozás Indítása";
          }
          return; // A szöveges mód végzett, ne menjen tovább a fájlos feldolgozóra!
        }

        inputItemsCache = items;

        activityLog.innerHTML = "";
        logBoxContainer.classList.remove("hidden");
        logSpeedInfo.textContent = "";

        processBtn.disabled = true;
        processBtn.innerHTML =
          '<span class="loading loading-spinner"></span> Feldolgozás...';

        statusAlert.className =
          "alert alert-info shadow-lg flex flex-col md:flex-row justify-between items-center gap-4";
        statusMessage.textContent = `Feldolgozás elindítva (0 / ${items.length})...`;
        progressBar.classList.remove("hidden");
        progressBar.value = 0;
        progressBar.max = items.length;
        progressPercent.textContent = "0%";
        exportCsvBtn.classList.add("hidden");

        try {
          const response = await fetch(`${API_BASE}/api/parse-batch-stream`, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Authorization: `Bearer ${authToken}`,
            },
            body: JSON.stringify({ items }),
          });

          if (!response.ok || !response.body) {
            const errJson = await response.json().catch(() => ({}));
            throw new Error(
              errJson.error || "Hiba történt a streaming indításakor.",
            );
          }

          const reader = response.body.getReader();
          const decoder = new TextDecoder("utf-8");
          let buffer = "";
          let totalCount = items.length;
          let completedCount = 0;

          while (true) {
            const { done, value } = await reader.read();
            if (done) break;

            buffer += decoder.decode(value, { stream: true });
            const lines = buffer.split("\n\n");
            buffer = lines.pop() || "";

            for (const chunk of lines) {
              if (!chunk.trim()) continue;

              const eventMatch = chunk.match(/^event:\s*(.+)$/m);
              const dataMatch = chunk.match(/^data:\s*(.+)$/m);

              const eventType = eventMatch ? eventMatch[1]?.trim() : "message";
              const rawData = dataMatch ? dataMatch[1]?.trim() : "";

              if (eventType === "start" && rawData) {
                const parsed = JSON.parse(rawData);
                totalCount = parsed.total || items.length;
                progressBar.max = totalCount;
                if (parsed.remainingCredits !== undefined) {
                  userCreditsDisplay.textContent = String(
                    parsed.remainingCredits,
                  );
                }
              } else if (eventType === "invoice-parsed" && rawData) {
                const invoiceResult = JSON.parse(rawData);
                lastProcessedResults.unshift(invoiceResult);

                renderResultsCards();

                completedCount++;
                progressBar.value = completedCount;
                const percent = Math.round((completedCount / totalCount) * 100);
                progressPercent.textContent = `${percent}%`;
                statusMessage.textContent = `Feldolgozás alatt: ${completedCount} / ${totalCount} számla kész...`;

                const logRow = document.createElement("div");
                const isOk = invoiceResult.success;
                const partner =
                  invoiceResult.data?.kiallito_neve || invoiceResult.source;
                const orderNum = invoiceResult.finishedOrder || completedCount;
                const time = invoiceResult.durationSeconds
                  ? `${invoiceResult.durationSeconds}s`
                  : "";

                logRow.className = `flex justify-between items-center py-0.5 border-b border-base-content/5 last:border-0 ${isOk ? "text-success" : "text-error"}`;
                logRow.innerHTML = `
                    <span><b>#${orderNum}.</b> ${isOk ? "✓" : "✕"} ${partner}</span>
                    <span class="text-[10px] text-base-content/50">${time}</span>
                  `;
                activityLog.appendChild(logRow);
                activityLog.scrollTop = activityLog.scrollHeight;
              } else if (eventType === "done") {
                const doneData = rawData ? JSON.parse(rawData) : {};
                statusAlert.className =
                  "alert alert-success shadow-lg flex flex-col md:flex-row justify-between items-center gap-4";
                statusMessage.textContent = `Mind a(z) ${completedCount} számla feldolgozva és elmentve!`;
                if (doneData.totalDuration)
                  logSpeedInfo.textContent = `Összidő: ${doneData.totalDuration} mp`;
                if (doneData.remainingCredits !== undefined) {
                  userCreditsDisplay.textContent = String(
                    doneData.remainingCredits,
                  );
                }
                progressBar.classList.add("hidden");
                progressPercent.textContent = "";
                exportCsvBtn.classList.remove("hidden");
              }
            }
          }
        } catch (err: any) {
          statusAlert.className = "alert alert-error shadow-lg flex";
          statusMessage.textContent = err.message || "Hálózati hiba.";
          progressBar.classList.add("hidden");
          progressPercent.textContent = "";
        } finally {
          processBtn.disabled = false;
          processBtn.textContent = "Feldolgozás Indítása";
        }
      });

      // Induláskori munkamenet vizsgálat
      checkCurrentSession();
    </script>
    
    <!-- CookieConsent V3 JS -->
    <script type="module" is:inline>
      import 'https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@v3.0.0/dist/cookieconsent.umd.js';
      
      const toggleScroll = (isShown) => {
        document.documentElement.style.overflow = isShown ? 'hidden' : '';
      };

      CookieConsent.run({
        guiOptions: {
          consentModal: {
            layout: "box",
            position: "bottom left",
            equalWeightButtons: true,
            flipButtons: false
          },
          preferencesModal: {
            layout: "box",
            position: "right",
            equalWeightButtons: true,
            flipButtons: false
          }
        },
        categories: {
          necessary: { readOnly: true },
          analytics: {},
          marketing: {}
        },
        language: {
          default: "hu",
          autoDetect: "browser",
          translations: {
            hu: {
              consentModal: {
                title: "Az oldal sütiket használ",
                description: "Weboldalunk sütiket használ a működés biztosítása, az analitika és a célzott marketing érdekében.",
                acceptAllBtn: "Mind elfogadása",
                acceptNecessaryBtn: "Csak szükségesek",
                showPreferencesBtn: "Testreszabás"
              },
              preferencesModal: {
                title: "Süti (Cookie) Beállítások",
                acceptAllBtn: "Mind elfogadása",
                acceptNecessaryBtn: "Csak szükségesek",
                savePreferencesBtn: "Beállítások mentése",
                closeIconLabel: "Bezárás",
                sections: [
                  {
                    title: "Süti Használat",
                    description: "Itt testreszabhatja a sütik kategóriáit."
                  },
                  {
                    title: "Szigorúan Szükséges Sütik <span class=\"pm__badge\">Mindig aktív</span>",
                    description: "Ezek a sütik a weboldal alapvető működéséhez szükségesek, például a bejelentkezéshez (localStorage).",
                    linkedCategory: "necessary"
                  },
                  {
                    title: "Analitikai Sütik",
                    description: "Ezek a sütik segítenek nekünk megérteni, hogyan használják a látogatók a weboldalt.",
                    linkedCategory: "analytics"
                  },
                  {
                    title: "Marketing Sütik",
                    description: "Ezek a sütik hirdetések személyre szabásához szükségesek (Google Ads).",
                    linkedCategory: "marketing"
                  }
                ]
              }
            }
          }
        },
        onFirstConsent: ({ cookie }) => updateGtmConsent(cookie.categories),
        onConsent: ({ cookie }) => updateGtmConsent(cookie.categories),
        onChange: ({ changedCategories, cookie }) => updateGtmConsent(cookie.categories),
        onModalShow: () => toggleScroll(true),
        onModalHide: () => toggleScroll(false)
      });
      
      function updateGtmConsent(categories) {
          const analyticsConsent = categories.includes('analytics') ? 'granted' : 'denied';
          const marketingConsent = categories.includes('marketing') ? 'granted' : 'denied';
          
          if(typeof window.gtag === 'function') {
            window.gtag('consent', 'update', {
                'analytics_storage': analyticsConsent,
                'ad_storage': marketingConsent,
                'ad_user_data': marketingConsent,
                'ad_personalization': marketingConsent
            });
          }
      }
    </script>
  </body>
</html>
