---
import "../styles/global.css";
import { SUPPORTED_CURRENCIES } from "../../../shared/types";
---

<html lang="hu" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Számla Feldolgozó (Split View & Dinamikus Devizák)</title>
  </head>
  <body class="min-h-screen bg-base-300 p-4 md:p-8 font-sans">
    <div class="max-w-5xl mx-auto space-y-6">
      <!-- Fejléc -->
      <div class="navbar bg-base-100 shadow-xl rounded-box">
        <div class="flex-1">
          <a class="btn btn-ghost text-xl text-primary font-bold">Számla Feldolgozó AI</a>
        </div>
        <div class="flex-none gap-2">
          <span class="badge badge-primary badge-outline">SSE Streaming</span>
          <span class="badge badge-secondary badge-outline">Split View</span>
        </div>
      </div>

      <!-- Beviteli doboz Fülekkel -->
      <div class="card bg-base-100 shadow-xl border border-base-200">
        <div class="card-body">
          <div role="tablist" class="tabs tabs-boxed mb-4">
            <a role="tab" id="tabUpload" class="tab tab-active font-medium">Fájl feltöltés / Drop / Paste</a>
            <a role="tab" id="tabUrl" class="tab font-medium">Kép URL linkek</a>
          </div>

          <!-- 1. Fül: Fájlok feltöltése / Drag & Drop / Paste -->
          <div id="panelUpload" class="space-y-4">
            <div
              id="dropZone"
              class="border-2 border-dashed border-base-content/20 hover:border-primary rounded-2xl p-6 text-center cursor-pointer transition-all duration-200 bg-base-200/40 hover:bg-base-200/80 flex flex-col items-center justify-center min-h-[160px] gap-2"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-10 w-10 text-primary/70 mb-1"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"
                ></path>
              </svg>
              <p class="font-medium text-sm md:text-base">
                Húzd ide a számlákat, <span class="text-primary underline">tallózd be</span>, vagy nyomj <kbd class="kbd kbd-sm">Ctrl</kbd> + <kbd class="kbd kbd-sm">V</kbd>-t
              </p>
              <p class="text-xs text-base-content/60">
                PNG, JPG, WebP formátumok, maximum 10 fájl
              </p>
              <input
                type="file"
                id="fileInput"
                accept="image/*"
                multiple
                class="hidden"
              />
            </div>

            <!-- Kijelölt képek előnézeti listája -->
            <div id="previewContainer" class="hidden space-y-2">
              <div class="flex justify-between items-center">
                <span class="text-xs font-semibold text-base-content/70" id="fileCountBadge">Kiválasztva: 0/10 kép</span>
                <button id="clearFilesBtn" class="btn btn-ghost btn-xs text-error">Összes törlése</button>
              </div>
              <div id="previewGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3"></div>
            </div>
          </div>

          <!-- 2. Fül: URL-ek megadása -->
          <div id="panelUrl" class="hidden space-y-3">
            <label class="block text-sm text-base-content/70">
              Illeszd be a képek közvetlen URL-jét (soronként 1 link, max 10 db):
            </label>
            <textarea
              id="urlInput"
              rows="4"
              placeholder="https://pelda.hu/szamla1.jpg&#10;https://pelda.hu/szamla2.png"
              class="textarea textarea-bordered w-full font-mono text-xs"
            ></textarea>
          </div>

          <div class="card-actions justify-end mt-4">
            <button id="processBtn" class="btn btn-primary w-full md:w-auto">
              Feldolgozás Indítása
            </button>
          </div>
        </div>
      </div>

      <!-- Globális Státusz és Export Sáv -->
      <div
        id="statusAlert"
        class="hidden alert shadow-lg flex-col md:flex-row justify-between items-center gap-4"
      >
        <div class="flex-1 w-full space-y-1">
          <div class="flex justify-between items-center">
            <span id="statusMessage" class="font-medium text-sm"></span>
            <span id="progressPercent" class="text-xs font-bold"></span>
          </div>
          <progress id="progressBar" class="progress progress-primary w-full hidden" value="0" max="100"></progress>
        </div>
        <button
          id="exportCsvBtn"
          class="btn btn-sm btn-neutral gap-2 hidden"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
            ></path>
          </svg>
          CSV Exportálása
        </button>
      </div>

      <!-- Élő Feldolgozási Sorrend Napló Panel -->
      <div id="logBoxContainer" class="hidden card bg-base-100 shadow-md border border-base-200">
        <div class="card-body p-3">
          <div class="flex justify-between items-center mb-1">
            <span class="text-xs font-bold uppercase tracking-wider text-base-content/70 flex items-center gap-2">
              <span class="inline-block w-2 h-2 rounded-full bg-success animate-pulse"></span>
              Élő Feldolgozási Sorrend Napló
            </span>
            <span class="text-[11px] text-base-content/50" id="logSpeedInfo"></span>
          </div>
          <div id="activityLog" class="space-y-1 font-mono text-xs max-h-36 overflow-y-auto bg-base-200/50 p-2 rounded-lg border border-base-300"></div>
        </div>
      </div>

      <!-- Eredmények konténere -->
      <div id="resultsWrapper" class="space-y-6"></div>
    </div>

    <!-- SPLIT VIEW & INLINE SZERKESZTŐ MODAL -->
    <dialog id="editModal" class="modal modal-bottom sm:modal-middle">
      <div class="modal-box w-11/12 max-w-7xl max-h-[92vh] flex flex-col p-4 md:p-6 bg-base-100">
        <!-- Modal Fejléc -->
        <div class="flex justify-between items-center border-b border-base-200 pb-3">
          <div class="flex items-center gap-3">
            <h3 class="font-bold text-lg text-primary" id="modalTitle">
              Számla Ellenőrzése és Módosítása
            </h3>
            <span id="modalValidBadge" class="badge">Valid</span>
          </div>
          <form method="dialog">
            <button class="btn btn-sm btn-circle btn-ghost">✕</button>
          </form>
        </div>

        <!-- Split Kétoszlopos Tartalom -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 my-4 flex-1 overflow-hidden">
          <!-- Bal Oszlop: Eredeti Számlakép -->
          <div class="lg:col-span-5 bg-base-200 rounded-xl p-2 flex flex-col items-center justify-start overflow-auto max-h-[40vh] lg:max-h-[68vh] border border-base-300">
            <div class="w-full flex justify-between items-center px-2 py-1 mb-1">
              <span class="text-xs text-base-content/60 font-medium">Eredeti számlakép</span>
              <a
                id="modalImageLink"
                target="_blank"
                class="text-xs text-primary underline hover:text-primary-focus"
              >
                Megnyitás új lapon ↗
              </a>
            </div>
            <img
              id="modalImage"
              class="max-w-full h-auto object-contain rounded shadow"
              src=""
              alt="Számla kép"
            />
          </div>

          <!-- Jobb Oszlop: Szerkeszthető Mezők és Tételek -->
          <div class="lg:col-span-7 flex flex-col gap-4 overflow-y-auto max-h-[45vh] lg:max-h-[68vh] pr-1">
            <!-- Fejléc mezők -->
            <div class="bg-base-200/50 p-3 rounded-xl border border-base-200 space-y-3">
              <h4 class="text-xs font-bold uppercase tracking-wider text-base-content/60">
                Fejléc Adatok
              </h4>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-xs">
                <div>
                  <label class="label label-text text-[11px] p-0 mb-1">Kiállító Neve</label>
                  <input
                    type="text"
                    id="edit_kiallito_neve"
                    class="input input-xs input-bordered w-full"
                  />
                </div>
                <div>
                  <label class="label label-text text-[11px] p-0 mb-1">Kiállító Adószáma</label>
                  <input
                    type="text"
                    id="edit_kiallito_adoszam"
                    class="input input-xs input-bordered w-full"
                  />
                </div>
                <div>
                  <label class="label label-text text-[11px] p-0 mb-1">Számlaszám</label>
                  <input
                    type="text"
                    id="edit_szamlaszam"
                    class="input input-xs input-bordered w-full font-mono font-bold"
                  />
                </div>
                <div>
                  <label class="label label-text text-[11px] p-0 mb-1">Vevő Neve</label>
                  <input
                    type="text"
                    id="edit_vevo_neve"
                    class="input input-xs input-bordered w-full"
                  />
                </div>
                <div>
                  <label class="label label-text text-[11px] p-0 mb-1">Kelt Dátum</label>
                  <input
                    type="date"
                    id="edit_kelt_datum"
                    class="input input-xs input-bordered w-full"
                  />
                </div>
                <div>
                  <label class="label label-text text-[11px] p-0 mb-1">Fizetési Határidő</label>
                  <input
                    type="date"
                    id="edit_fizetesi_hatarido"
                    class="input input-xs input-bordered w-full"
                  />
                </div>
              </div>

              <!-- Pénznem Select Dropdown -->
              <div class="flex items-center gap-3 pt-1">
                <div class="w-44">
                  <label class="label label-text text-[11px] p-0 mb-1">Pénznem (ISO)</label>
                  <select
                    id="edit_penznem"
                    class="select select-xs select-bordered w-full font-bold"
                  >
                    {
                      SUPPORTED_CURRENCIES.map((curr) => (
                        <option value={curr.code}>
                          {curr.code} ({curr.symbol})
                        </option>
                      ))
                    }
                  </select>
                </div>
                <div class="w-24">
                  <label class="label label-text text-[11px] p-0 mb-1">Ország</label>
                  <input
                    type="text"
                    id="edit_orszag"
                    class="input input-xs input-bordered w-full uppercase"
                  />
                </div>
              </div>
            </div>

            <!-- Tételek Táblázat -->
            <div class="space-y-2">
              <div class="flex justify-between items-center">
                <h4 class="text-xs font-bold uppercase tracking-wider text-base-content/60">
                  Tételsorok
                </h4>
                <button
                  id="addItemBtn"
                  class="btn btn-xs btn-outline btn-primary"
                >
                  + Új tétel
                </button>
              </div>

              <div class="overflow-x-auto border border-base-200 rounded-lg">
                <table class="table table-xs w-full" id="editItemsTable">
                  <thead class="bg-base-200">
                    <tr>
                      <th class="w-1/3">Megnevezés</th>
                      <th class="w-12 text-right">Menny.</th>
                      <th class="w-20 text-right">Egységár</th>
                      <th class="w-14 text-right">Áfa %</th>
                      <th class="w-20 text-right">Nettó</th>
                      <th class="w-20 text-right">Áfa érték</th>
                      <th class="w-20 text-right">Bruttó</th>
                      <th class="w-8"></th>
                    </tr>
                  </thead>
                  <tbody id="editItemsTbody"></tbody>
                </table>
              </div>
            </div>

            <!-- Összesítők és Végösszeg Kártya -->
            <div
              class="bg-base-200 p-3 rounded-xl flex flex-wrap justify-between items-center gap-3 border border-base-300 mt-auto"
            >
              <div class="text-xs space-y-1">
                <div>Nettó összesen: <b id="displayNetto">0</b></div>
                <div>Áfa összesen: <b id="displayAfa">0</b></div>
              </div>
              <div class="text-right">
                <span class="text-xs text-base-content/60 block">Fizetendő Bruttó:</span>
                <span class="text-lg font-bold text-success" id="displayBrutto">0</span>
              </div>
            </div>

            <div
              id="modalWarningBox"
              class="hidden alert alert-warning text-xs p-2 rounded-lg"
            >
            </div>
          </div>
        </div>

        <!-- Modal Alsó Gombok -->
        <div
          class="modal-action border-t border-base-200 pt-3 flex justify-between items-center"
        >
          <button id="cancelModalBtn" class="btn btn-sm btn-ghost">Mégse</button>
          <button id="saveChangesBtn" class="btn btn-sm btn-primary">Változtatások Mentése</button>
        </div>
      </div>
    </dialog>

    <script>
      import type {
        ImageInputItem,
        SingleInvoiceResult,
        InvoiceData,
        InvoiceItem,
      } from "../../../shared/types";
      import { SUPPORTED_CURRENCIES } from "../../../shared/types";

      const tabUpload = document.getElementById("tabUpload") as HTMLAnchorElement;
      const tabUrl = document.getElementById("tabUrl") as HTMLAnchorElement;
      const panelUpload = document.getElementById("panelUpload") as HTMLDivElement;
      const panelUrl = document.getElementById("panelUrl") as HTMLDivElement;

      const dropZone = document.getElementById("dropZone") as HTMLDivElement;
      const fileInput = document.getElementById("fileInput") as HTMLInputElement;
      const previewContainer = document.getElementById("previewContainer") as HTMLDivElement;
      const previewGrid = document.getElementById("previewGrid") as HTMLDivElement;
      const fileCountBadge = document.getElementById("fileCountBadge") as HTMLSpanElement;
      const clearFilesBtn = document.getElementById("clearFilesBtn") as HTMLButtonElement;

      const urlInput = document.getElementById("urlInput") as HTMLTextAreaElement;
      const processBtn = document.getElementById("processBtn") as HTMLButtonElement;
      const statusAlert = document.getElementById("statusAlert") as HTMLDivElement;
      const statusMessage = document.getElementById("statusMessage") as HTMLSpanElement;
      const progressBar = document.getElementById("progressBar") as HTMLProgressElement;
      const progressPercent = document.getElementById("progressPercent") as HTMLSpanElement;
      const exportCsvBtn = document.getElementById("exportCsvBtn") as HTMLButtonElement;
      const resultsWrapper = document.getElementById("resultsWrapper") as HTMLDivElement;

      // Napló elemek
      const logBoxContainer = document.getElementById("logBoxContainer") as HTMLDivElement;
      const activityLog = document.getElementById("activityLog") as HTMLDivElement;
      const logSpeedInfo = document.getElementById("logSpeedInfo") as HTMLSpanElement;

      // Modal elemek
      const editModal = document.getElementById("editModal") as HTMLDialogElement;
      const modalImage = document.getElementById("modalImage") as HTMLImageElement;
      const modalImageLink = document.getElementById("modalImageLink") as HTMLAnchorElement;
      const modalValidBadge = document.getElementById("modalValidBadge") as HTMLSpanElement;
      const modalWarningBox = document.getElementById("modalWarningBox") as HTMLDivElement;

      const editKiallitoNeve = document.getElementById("edit_kiallito_neve") as HTMLInputElement;
      const editKiallitoAdoszam = document.getElementById("edit_kiallito_adoszam") as HTMLInputElement;
      const editSzamlaszam = document.getElementById("edit_szamlaszam") as HTMLInputElement;
      const editVevoNeve = document.getElementById("edit_vevo_neve") as HTMLInputElement;
      const editKeltDatum = document.getElementById("edit_kelt_datum") as HTMLInputElement;
      const editFizetesiHatarido = document.getElementById("edit_fizetesi_hatarido") as HTMLInputElement;
      const editPenznem = document.getElementById("edit_penznem") as HTMLSelectElement;
      const editOrszag = document.getElementById("edit_orszag") as HTMLInputElement;

      const editItemsTbody = document.getElementById("editItemsTbody") as HTMLTableSectionElement;
      const addItemBtn = document.getElementById("addItemBtn") as HTMLButtonElement;
      const displayNetto = document.getElementById("displayNetto") as HTMLElement;
      const displayAfa = document.getElementById("displayAfa") as HTMLElement;
      const displayBrutto = document.getElementById("displayBrutto") as HTMLElement;
      const saveChangesBtn = document.getElementById("saveChangesBtn") as HTMLButtonElement;
      const cancelModalBtn = document.getElementById("cancelModalBtn") as HTMLButtonElement;

      let currentMode: "upload" | "url" = "upload";
      let selectedFiles: File[] = [];
      let inputItemsCache: ImageInputItem[] = [];
      let lastProcessedResults: SingleInvoiceResult[] = [];
      let activeEditIndex: number = -1;
      let currentEditingData: InvoiceData | null = null;

      // Fülváltás
      tabUpload.addEventListener("click", () => {
        currentMode = "upload";
        tabUpload.classList.add("tab-active");
        tabUrl.classList.remove("tab-active");
        panelUpload.classList.remove("hidden");
        panelUrl.classList.add("hidden");
      });

      tabUrl.addEventListener("click", () => {
        currentMode = "url";
        tabUrl.classList.add("tab-active");
        tabUpload.classList.remove("tab-active");
        panelUrl.classList.remove("hidden");
        panelUpload.classList.add("hidden");
      });

      function formatCurrency(amount: number, currency: string = "HUF"): string {
        try {
          const cleanCurrency = (currency || "HUF").toUpperCase().trim();
          const isHUF = cleanCurrency === "HUF";

          return new Intl.NumberFormat("hu-HU", {
            style: "currency",
            currency: cleanCurrency,
            maximumFractionDigits: isHUF ? 0 : 2,
            minimumFractionDigits: isHUF ? 0 : 2,
          }).format(amount || 0);
        } catch {
          return `${Number(amount || 0).toLocaleString("hu-HU")} ${currency}`;
        }
      }

      function fileToBase64(file: File): Promise<string> {
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => resolve(reader.result as string);
          reader.onerror = reject;
          reader.readAsDataURL(file);
        });
      }

      function handleNewFiles(files: File[]) {
        const imageFiles = files.filter((f) => f.type.startsWith("image/"));
        if (imageFiles.length === 0) return;

        const combined = [...selectedFiles, ...imageFiles];
        if (combined.length > 10) {
          alert("Egyszerre maximum 10 képet adhatsz hozzá!");
          selectedFiles = combined.slice(0, 10);
        } else {
          selectedFiles = combined;
        }

        renderPreviews();
      }

      function renderPreviews() {
        previewGrid.innerHTML = "";
        if (selectedFiles.length === 0) {
          previewContainer.classList.add("hidden");
          return;
        }

        previewContainer.classList.remove("hidden");
        fileCountBadge.textContent = `Kiválasztva: ${selectedFiles.length}/10 kép`;

        selectedFiles.forEach((file, index) => {
          const item = document.createElement("div");
          item.className =
            "relative group rounded-lg overflow-hidden border border-base-200 bg-base-300 aspect-video flex items-center justify-center";

          const img = document.createElement("img");
          img.src = URL.createObjectURL(file);
          img.className = "w-full h-full object-cover";

          const removeBtn = document.createElement("button");
          removeBtn.innerHTML = "&times;";
          removeBtn.className =
            "absolute top-1 right-1 btn btn-circle btn-xs btn-error opacity-80 group-hover:opacity-100";
          removeBtn.title = "Kép eltávolítása";
          removeBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            selectedFiles.splice(index, 1);
            renderPreviews();
          });

          const nameTag = document.createElement("span");
          nameTag.className =
            "absolute bottom-0 inset-x-0 bg-black/60 text-[10px] text-white px-1 py-0.5 truncate text-center";
          nameTag.textContent = file.name;

          item.appendChild(img);
          item.appendChild(removeBtn);
          item.appendChild(nameTag);
          previewGrid.appendChild(item);
        });
      }

      clearFilesBtn.addEventListener("click", () => {
        selectedFiles = [];
        renderPreviews();
        fileInput.value = "";
      });

      dropZone.addEventListener("click", () => fileInput.click());
      fileInput.addEventListener("change", () => {
        if (fileInput.files) handleNewFiles(Array.from(fileInput.files));
      });

      ["dragenter", "dragover"].forEach((eventName) => {
        dropZone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropZone.classList.add("border-primary", "bg-primary/10");
        });
      });

      ["dragleave", "drop"].forEach((eventName) => {
        dropZone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropZone.classList.remove("border-primary", "bg-primary/10");
        });
      });

      dropZone.addEventListener("drop", (e) => {
        const dt = e.dataTransfer;
        if (dt?.files) handleNewFiles(Array.from(dt.files));
      });

      window.addEventListener("paste", (e: ClipboardEvent) => {
        if (currentMode !== "upload") return;
        const clipboardItems = e.clipboardData?.items;
        if (!clipboardItems) return;

        const pastedFiles: File[] = [];
        for (let i = 0; i < clipboardItems.length; i++) {
          if (clipboardItems[i].type.startsWith("image/")) {
            const blob = clipboardItems[i].getAsFile();
            if (blob) {
              const file = new File(
                [blob],
                `beillesztett_szamla_${Date.now()}.png`,
                { type: blob.type },
              );
              pastedFiles.push(file);
            }
          }
        }
        if (pastedFiles.length > 0) handleNewFiles(pastedFiles);
      });

      // SPLIT VIEW & SZERKESZTŐ LOGIKA
      function openEditModal(index: number) {
        const item = lastProcessedResults[index];
        if (!item || !item.data) return;

        activeEditIndex = index;
        currentEditingData = JSON.parse(JSON.stringify(item.data));

        const inputItem = inputItemsCache[index];
        let imageSrc = "";
        if (inputItem) {
          imageSrc =
            inputItem.type === "base64"
              ? inputItem.data.startsWith("data:")
                ? inputItem.data
                : `data:${inputItem.mimeType || "image/jpeg"};base64,${inputItem.data}`
              : inputItem.data;
        }

        modalImage.src = imageSrc;
        modalImageLink.href = imageSrc;

        editKiallitoNeve.value = currentEditingData?.kiallito_neve || "";
        editKiallitoAdoszam.value = currentEditingData?.kiallito_adoszam || "";
        editSzamlaszam.value = currentEditingData?.szamlaszam || "";
        editVevoNeve.value = currentEditingData?.vevo_neve || "";
        editKeltDatum.value = currentEditingData?.kelt_datum || "";
        editFizetesiHatarido.value = currentEditingData?.fizetesi_hatarido || "";
        editOrszag.value = currentEditingData?.kiallito_orszag || "";

        const currentCur = (currentEditingData?.penznem || "HUF").toUpperCase().trim();
        const isSupported = SUPPORTED_CURRENCIES.some(
          (c) => c.code === currentCur,
        );

        const dynamicExisting = Array.from(editPenznem.options).some(
          (opt) => opt.value === currentCur,
        );
        if (!isSupported && !dynamicExisting && currentCur) {
          const newOpt = document.createElement("option");
          newOpt.value = currentCur;
          newOpt.textContent = `${currentCur} (AI talált)`;
          editPenznem.appendChild(newOpt);
        }
        editPenznem.value = currentCur;

        renderEditItems();
        recalculateModalTotals();

        editModal.showModal();
      }

      function renderEditItems() {
        if (!currentEditingData) return;
        editItemsTbody.innerHTML = "";

        const cur = editPenznem.value || "HUF";

        (currentEditingData.tetelek || []).forEach((t, i) => {
          const tr = document.createElement("tr");
          tr.innerHTML = `
            <td>
              <input type="text" class="input input-xs input-bordered w-full item-name" data-index="${i}" value="${t.megnevezes || ""}" />
            </td>
            <td>
              <input type="number" step="any" class="input input-xs input-bordered w-full text-right item-qty" data-index="${i}" value="${t.mennyiseg || 1}" />
            </td>
            <td>
              <input type="number" step="any" class="input input-xs input-bordered w-full text-right item-unit" data-index="${i}" value="${t.egysegar || 0}" />
            </td>
            <td>
              <input type="number" step="any" class="input input-xs input-bordered w-full text-right item-vat-rate" data-index="${i}" value="${t.afa_szazalek || 0}" />
            </td>
            <td class="text-right font-medium text-xs item-net-display">${formatCurrency(t.netto_ar, cur)}</td>
            <td class="text-right text-xs text-base-content/70 item-vat-display">${formatCurrency(t.afa_ertek || 0, cur)}</td>
            <td class="text-right font-bold text-xs item-gross-display">${formatCurrency(t.brutto_ar, cur)}</td>
            <td class="text-center">
              <button class="btn btn-ghost btn-xs text-error btn-circle remove-item-btn" data-index="${i}">&times;</button>
            </td>
          `;
          editItemsTbody.appendChild(tr);
        });

        editItemsTbody
          .querySelectorAll(".item-qty, .item-unit, .item-vat-rate")
          .forEach((input) => {
            input.addEventListener("input", (e) => {
              const idx = Number(
                (e.target as HTMLElement).getAttribute("data-index"),
              );
              const row = (e.target as HTMLElement).closest("tr");
              if (
                !row ||
                !currentEditingData ||
                !currentEditingData.tetelek[idx]
              )
                return;

              const qty =
                parseFloat(
                  (row.querySelector(".item-qty") as HTMLInputElement).value,
                ) || 0;
              const unit =
                parseFloat(
                  (row.querySelector(".item-unit") as HTMLInputElement).value,
                ) || 0;
              const vatRate =
                parseFloat(
                  (row.querySelector(".item-vat-rate") as HTMLInputElement)
                    .value,
                ) || 0;

              const net = qty * unit;
              const vat = net * (vatRate / 100);
              const gross = net + vat;

              currentEditingData.tetelek[idx].mennyiseg = qty;
              currentEditingData.tetelek[idx].egysegar = unit;
              currentEditingData.tetelek[idx].afa_szazalek = vatRate;
              currentEditingData.tetelek[idx].netto_ar = net;
              currentEditingData.tetelek[idx].afa_ertek = vat;
              currentEditingData.tetelek[idx].brutto_ar = gross;

              const selectedCur = editPenznem.value || "HUF";
              (
                row.querySelector(".item-net-display") as HTMLElement
              ).textContent = formatCurrency(net, selectedCur);
              (
                row.querySelector(".item-vat-display") as HTMLElement
              ).textContent = formatCurrency(vat, selectedCur);
              (
                row.querySelector(".item-gross-display") as HTMLElement
              ).textContent = formatCurrency(gross, selectedCur);

              recalculateModalTotals();
            });
          });

        editItemsTbody.querySelectorAll(".item-name").forEach((input) => {
          input.addEventListener("input", (e) => {
            const idx = Number(
              (e.target as HTMLElement).getAttribute("data-index"),
            );
            if (currentEditingData && currentEditingData.tetelek[idx]) {
              currentEditingData.tetelek[idx].megnevezes = (
                e.target as HTMLInputElement
              ).value;
            }
          });
        });

        editItemsTbody.querySelectorAll(".remove-item-btn").forEach((btn) => {
          btn.addEventListener("click", (e) => {
            const idx = Number(
              (e.target as HTMLElement).getAttribute("data-index"),
            );
            if (currentEditingData) {
              currentEditingData.tetelek.splice(idx, 1);
              renderEditItems();
              recalculateModalTotals();
            }
          });
        });
      }

      addItemBtn.addEventListener("click", () => {
        if (!currentEditingData) return;
        currentEditingData.tetelek = currentEditingData.tetelek || [];
        currentEditingData.tetelek.push({
          megnevezes: "Új tétel",
          mennyiseg: 1,
          egysegar: 0,
          afa_szazalek: 27,
          netto_ar: 0,
          afa_ertek: 0,
          brutto_ar: 0,
        });
        renderEditItems();
        recalculateModalTotals();
      });

      function recalculateModalTotals() {
        if (!currentEditingData) return;

        const cur = editPenznem.value || "HUF";
        let sumNetto = 0;
        let sumAfa = 0;
        let sumBrutto = 0;

        (currentEditingData.tetelek || []).forEach((t) => {
          sumNetto += Number(t.netto_ar || 0);
          sumAfa += Number(t.afa_ertek || 0);
          sumBrutto += Number(t.brutto_ar || 0);
        });

        currentEditingData.vegosszeg_netto = sumNetto;
        currentEditingData.vegosszeg_afa = sumAfa;
        currentEditingData.vegosszeg_brutto = sumBrutto;
        currentEditingData.penznem = cur;

        displayNetto.textContent = formatCurrency(sumNetto, cur);
        displayAfa.textContent = formatCurrency(sumAfa, cur);
        displayBrutto.textContent = formatCurrency(sumBrutto, cur);

        const mathValid = Math.abs(sumNetto + sumAfa - sumBrutto) <= 1.0;
        if (mathValid) {
          modalValidBadge.className = "badge badge-success";
          modalValidBadge.textContent = "✓ Valid";
          modalWarningBox.classList.add("hidden");
        } else {
          modalValidBadge.className = "badge badge-warning";
          modalValidBadge.textContent = "⚠ Eltérés";
          modalWarningBox.textContent = `A számított nettó (${sumNetto.toFixed(2)}) és áfa (${sumAfa.toFixed(2)}) nem egyezik a bruttóval (${sumBrutto.toFixed(2)}).`;
          modalWarningBox.classList.remove("hidden");
        }
      }

      editPenznem.addEventListener("change", () => {
        if (currentEditingData) {
          currentEditingData.penznem = editPenznem.value;
        }
        renderEditItems();
        recalculateModalTotals();
      });

      saveChangesBtn.addEventListener("click", () => {
        if (activeEditIndex === -1 || !currentEditingData) return;

        currentEditingData.kiallito_neve = editKiallitoNeve.value;
        currentEditingData.kiallito_adoszam = editKiallitoAdoszam.value;
        currentEditingData.szamlaszam = editSzamlaszam.value;
        currentEditingData.vevo_neve = editVevoNeve.value;
        currentEditingData.kelt_datum = editKeltDatum.value;
        currentEditingData.fizetesi_hatarido = editFizetesiHatarido.value;
        currentEditingData.penznem = editPenznem.value.toUpperCase();
        currentEditingData.kiallito_orszag = editOrszag.value.toUpperCase();

        lastProcessedResults[activeEditIndex].data = currentEditingData;
        lastProcessedResults[activeEditIndex].isValid = true;
        lastProcessedResults[activeEditIndex].errors = [];

        renderResultsCards();
        editModal.close();
      });

      cancelModalBtn.addEventListener("click", () => {
        editModal.close();
      });

      // EGYETLEN KÁRTYA HTML GENERÁLÓ FÜGGVÉNY
      function createCardElement(item: SingleInvoiceResult, index: number): HTMLElement {
        const card = document.createElement("div");
        card.id = `card-item-${index}`;
        card.className =
          "card bg-base-100 shadow-xl border border-base-200 hover:border-primary/40 transition-all duration-300";

        if (!item.success || !item.data) {
          card.innerHTML = `
          <div class="card-body">
            <div class="flex justify-between items-center">
              <h3 class="font-bold text-error">Hiba: ${item.source}</h3>
              <span class="badge badge-error">Sikertelen</span>
            </div>
            <p class="text-xs text-base-content/70 mt-2">${item.errors.join(", ")}</p>
          </div>
        `;
        } else {
          const d = item.data;
          const currency = d.penznem || "HUF";

          const rows = (d.tetelek || [])
            .map((t) => {
              const afaErtek =
                t.afa_ertek !== undefined && t.afa_ertek !== null
                  ? t.afa_ertek
                  : Number(t.brutto_ar || 0) - Number(t.netto_ar || 0);

              return `
            <tr>
              <td class="font-medium">${t.megnevezes || "-"}</td>
              <td class="text-right">${t.mennyiseg}</td>
              <td class="text-right">${formatCurrency(t.egysegar, currency)}</td>
              <td class="text-right"><span class="badge badge-ghost badge-sm">${t.afa_szazalek}%</span></td>
              <td class="text-right">${formatCurrency(t.netto_ar, currency)}</td>
              <td class="text-right text-base-content/70">${formatCurrency(afaErtek, currency)}</td>
              <td class="text-right font-semibold">${formatCurrency(t.brutto_ar, currency)}</td>
            </tr>
          `;
            })
            .join("");

          const errorAlert = !item.isValid
            ? `
          <div class="alert alert-warning text-xs p-2 rounded-lg mt-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-4 w-4" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            <span><b>Figyelmeztetés:</b> ${item.errors.join(" | ")}</span>
          </div>
        `
            : "";

          card.innerHTML = `
          <div class="card-body space-y-4">
            <div class="flex flex-wrap justify-between items-center border-b border-base-200 pb-3 gap-2">
              <div>
                <h3 class="font-bold text-lg text-primary">
                  ${d.kiallito_neve || "Ismeretlen kiállító"}
                  ${d.kiallito_orszag ? `<span class="badge badge-sm badge-outline ml-1">${d.kiallito_orszag}</span>` : ""}
                </h3>
                <div class="text-xs text-base-content/60">
                  Számlaszám: <span class="font-mono font-semibold">${d.szamlaszam || "Nincs"}</span> 
                  ${d.kiallito_adoszam ? `| Adószám: ${d.kiallito_adoszam}` : ""}
                </div>
              </div>
              <div class="flex items-center gap-2">
                <span class="badge badge-accent font-bold">${currency}</span>
                <span class="badge ${item.isValid ? "badge-success" : "badge-warning"}">
                  ${item.isValid ? "✓ Valid" : "⚠ Ellenőrizendő"}
                </span>
                <button class="btn btn-sm btn-outline btn-primary edit-card-btn ml-2" data-index="${index}">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                  </svg>
                  Ellenőrzés / Szerkesztés
                </button>
              </div>
            </div>

            ${errorAlert}

            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3 text-xs bg-base-200/50 p-3 rounded-box">
              <div><span class="text-base-content/50 block">Vevő:</span> <span class="font-medium">${d.vevo_neve || "-"}</span></div>
              <div><span class="text-base-content/50 block">Kelt:</span> <span class="font-medium">${d.kelt_datum || "-"}</span></div>
              <div><span class="text-base-content/50 block">Fiz. határidő:</span> <span class="font-medium">${d.fizetesi_hatarido || "-"}</span></div>
              <div><span class="text-base-content/50 block">Nettó összesen:</span> <span class="font-medium">${formatCurrency(d.vegosszeg_netto, currency)}</span></div>
              <div><span class="text-base-content/50 block">ÁFA összesen:</span> <span class="font-medium">${formatCurrency(d.vegosszeg_afa, currency)}</span></div>
            </div>

            <div class="flex justify-between items-center bg-base-200 px-4 py-2 rounded-lg">
              <span class="text-sm font-semibold text-base-content/80">Fizetendő bruttó végösszeg:</span>
              <span class="text-lg font-bold text-success">${formatCurrency(d.vegosszeg_brutto, currency)}</span>
            </div>

            <div class="overflow-x-auto border border-base-200 rounded-lg">
              <table class="table table-xs table-zebra w-full">
                <thead class="bg-base-200/60">
                  <tr>
                    <th>Tétel</th>
                    <th class="text-right">Mennyiség</th>
                    <th class="text-right">Egységár</th>
                    <th class="text-right">ÁFA %</th>
                    <th class="text-right">Nettó</th>
                    <th class="text-right">ÁFA érték</th>
                    <th class="text-right">Bruttó</th>
                  </tr>
                </thead>
                <tbody>${rows}</tbody>
              </table>
            </div>
          </div>
        `;

          card.querySelector(".edit-card-btn")?.addEventListener("click", () => {
            openEditModal(index);
          });
        }

        return card;
      }

      function appendOrUpdateCard(item: SingleInvoiceResult) {
        const existingCard = document.getElementById(`card-item-${item.index}`);
        const newCard = createCardElement(item, item.index);
        if (existingCard) {
          existingCard.replaceWith(newCard);
        } else {
          resultsWrapper.appendChild(newCard);
        }
      }

      function renderResultsCards() {
        resultsWrapper.innerHTML = "";
        lastProcessedResults.forEach((item) => {
          resultsWrapper.appendChild(createCardElement(item, item.index));
        });
      }

      // CSV EXPORT
      function exportToCSV(results: SingleInvoiceResult[]) {
        const formatNumberForExcel = (
          num: number | undefined | null,
        ): string => {
          if (num === undefined || num === null || isNaN(Number(num)))
            return "0";
          return String(num).replace(".", ",");
        };

        const rows: string[][] = [
          [
            "Számlaszám",
            "Kiállító",
            "Kiállító Adószám",
            "Ország",
            "Vevő",
            "Kelt",
            "Fizetési Határidő",
            "Pénznem",
            "Tétel Megnevezés",
            "Mennyiség",
            "Egységár",
            "Áfa %",
            "Tétel Nettó",
            "Tétel Áfa",
            "Tétel Bruttó",
            "Számla Végösszeg Bruttó",
            "Státusz",
          ],
        ];

        results.forEach((res) => {
          if (res.success && res.data) {
            const d = res.data;
            const currency = d.penznem || "HUF";

            if (d.tetelek && d.tetelek.length > 0) {
              d.tetelek.forEach((item) => {
                const afaErtek =
                  item.afa_ertek !== undefined && item.afa_ertek !== null
                    ? item.afa_ertek
                    : Number(item.brutto_ar || 0) - Number(item.netto_ar || 0);

                rows.push([
                  `"${d.szamlaszam || ""}"`,
                  `"${d.kiallito_neve || ""}"`,
                  `"${d.kiallito_adoszam || ""}"`,
                  `"${d.kiallito_orszag || ""}"`,
                  `"${d.vevo_neve || ""}"`,
                  `"${d.kelt_datum || ""}"`,
                  `"${d.fizetesi_hatarido || ""}"`,
                  `"${currency}"`,
                  `"${(item.megnevezes || "").replace(/"/g, '""')}"`,
                  formatNumberForExcel(item.mennyiseg || 1),
                  formatNumberForExcel(item.egysegar || 0),
                  formatNumberForExcel(item.afa_szazalek || 0),
                  formatNumberForExcel(item.netto_ar || 0),
                  formatNumberForExcel(afaErtek || 0),
                  formatNumberForExcel(item.brutto_ar || 0),
                  formatNumberForExcel(d.vegosszeg_brutto || 0),
                  res.isValid ? "Érvényes" : "Összegzési eltérés",
                ]);
              });
            } else {
              rows.push([
                `"${d.szamlaszam || ""}"`,
                `"${d.kiallito_neve || ""}"`,
                `"${d.kiallito_adoszam || ""}"`,
                `"${d.kiallito_orszag || ""}"`,
                `"${d.vevo_neve || ""}"`,
                `"${d.kelt_datum || ""}"`,
                `"${d.fizetesi_hatarido || ""}"`,
                `"${currency}"`,
                '"N/A"',
                "1",
                formatNumberForExcel(d.vegosszeg_netto || 0),
                '"N/A"',
                formatNumberForExcel(d.vegosszeg_netto || 0),
                formatNumberForExcel(d.vegosszeg_afa || 0),
                formatNumberForExcel(d.vegosszeg_brutto || 0),
                formatNumberForExcel(d.vegosszeg_brutto || 0),
                res.isValid ? "Érvényes" : "Összegzési eltérés",
              ]);
            }
          }
        });

        const csvContent = "\uFEFF" + rows.map((e) => e.join(";")).join("\n");
        const blob = new Blob([csvContent], {
          type: "text/csv;charset=utf-8;",
        });
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.setAttribute("href", url);
        link.setAttribute(
          "download",
          `szamlak_export_${new Date().toISOString().slice(0, 10)}.csv`,
        );
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      }

      exportCsvBtn.addEventListener("click", () => {
        if (lastProcessedResults.length > 0) {
          exportToCSV(lastProcessedResults);
        }
      });

      // FELDOLGOZÁS INDÍTÁSA (SSE STREAMING VEZÉRLÉS + ÉLŐ LOG)
      processBtn.addEventListener("click", async () => {
        const items: ImageInputItem[] = [];

        if (currentMode === "upload") {
          if (selectedFiles.length === 0) {
            alert("Válassz ki, dobj be vagy illessz be (Ctrl+V) legalább egy képet!");
            return;
          }

          for (const file of selectedFiles) {
            const base64 = await fileToBase64(file);
            items.push({ type: "base64", data: base64, mimeType: file.type });
          }
        } else {
          const urls = urlInput.value
            .split("\n")
            .map((u) => u.trim())
            .filter((u) => u.length > 0);

          if (urls.length === 0) {
            alert("Adj meg legalább egy kép URL-t!");
            return;
          }
          if (urls.length > 10) {
            alert("Egyszerre maximum 10 URL-t adhatsz meg!");
            return;
          }

          for (const u of urls) {
            items.push({ type: "url", data: u });
          }
        }

        inputItemsCache = items;
        lastProcessedResults = [];
        resultsWrapper.innerHTML = "";

        // UI és Log panel alaphelyzetbe állítása
        activityLog.innerHTML = "";
        logBoxContainer.classList.remove("hidden");
        logSpeedInfo.textContent = "";

        processBtn.disabled = true;
        processBtn.innerHTML = '<span class="loading loading-spinner"></span> Feldolgozás folyamatban...';

        statusAlert.className = "alert alert-info shadow-lg flex flex-col md:flex-row justify-between items-center gap-4";
        statusMessage.textContent = `Feldolgozás elindítva (0 / ${items.length})...`;
        progressBar.classList.remove("hidden");
        progressBar.value = 0;
        progressBar.max = items.length;
        progressPercent.textContent = "0%";
        exportCsvBtn.classList.add("hidden");

        const API_BASE = import.meta.env.PUBLIC_API_URL || "http://localhost:3000";

        try {
          const response = await fetch(`${API_BASE}/api/parse-batch-stream`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ items }),
          });

          if (!response.ok || !response.body) {
            const errText = await response.text();
            throw new Error(errText || "Hiba történt a streaming kapcsolat indításakor.");
          }

          const reader = response.body.getReader();
          const decoder = new TextDecoder("utf-8");
          let buffer = "";
          let totalCount = items.length;
          let completedCount = 0;

          while (true) {
            const { done, value } = await reader.read();
            if (done) break;

            buffer += decoder.decode(value, { stream: true });
            const lines = buffer.split("\n\n");
            buffer = lines.pop() || "";

            for (const chunk of lines) {
              if (!chunk.trim()) continue;

              const eventMatch = chunk.match(/^event:\s*(.+)$/m);
              const dataMatch = chunk.match(/^data:\s*(.+)$/m);

              const eventType = eventMatch ? eventMatch[1].trim() : "message";
              const rawData = dataMatch ? dataMatch[1].trim() : "";

              if (eventType === "start" && rawData) {
                const parsed = JSON.parse(rawData);
                totalCount = parsed.total || items.length;
                progressBar.max = totalCount;
              } else if (eventType === "invoice-parsed" && rawData) {
                const invoiceResult = JSON.parse(rawData);
                lastProcessedResults.push(invoiceResult);
                
                // Kártya azonnali kirajzolása valós időben
                appendOrUpdateCard(invoiceResult);

                completedCount++;
                progressBar.value = completedCount;
                const percent = Math.round((completedCount / totalCount) * 100);
                progressPercent.textContent = `${percent}%`;
                statusMessage.textContent = `Feldolgozás alatt: ${completedCount} / ${totalCount} számla kész...`;

                // Élő napló bejegyzés hozzáadása
                const logRow = document.createElement("div");
                const isOk = invoiceResult.success;
                const partner = invoiceResult.data?.kiallito_neve || invoiceResult.source;
                const orderNum = invoiceResult.finishedOrder || completedCount;
                const time = invoiceResult.durationSeconds ? `${invoiceResult.durationSeconds}s` : '';

                logRow.className = `flex justify-between items-center py-0.5 border-b border-base-content/5 last:border-0 ${isOk ? 'text-success' : 'text-error'}`;
                logRow.innerHTML = `
                  <span><b>#${orderNum}.</b> ${isOk ? '✓' : '✕'} <b>[Kép #${invoiceResult.index + 1}]</b> ${partner}</span>
                  <span class="text-[10px] text-base-content/50">${time}</span>
                `;
                activityLog.appendChild(logRow);
                activityLog.scrollTop = activityLog.scrollHeight;

                console.log(`[Stream #${orderNum}] Elkészült: Kép #${invoiceResult.index + 1} (${partner}) -> ${time}`);

              } else if (eventType === "done") {
                const doneData = rawData ? JSON.parse(rawData) : {};
                statusAlert.className = "alert alert-success shadow-lg flex flex-col md:flex-row justify-between items-center gap-4";
                statusMessage.textContent = `Sikeresen feldolgozva mind a(z) ${completedCount} számla!`;
                if (doneData.totalDuration) {
                  logSpeedInfo.textContent = `Összidő: ${doneData.totalDuration} mp`;
                }
                progressBar.classList.add("hidden");
                progressPercent.textContent = "";
                exportCsvBtn.classList.remove("hidden");
              }
            }
          }
        } catch (err: any) {
          statusAlert.className = "alert alert-error shadow-lg flex";
          statusMessage.textContent = err.message || "Hálózati hiba a streaming során.";
          progressBar.classList.add("hidden");
          progressPercent.textContent = "";
        } finally {
          processBtn.disabled = false;
          processBtn.textContent = "Feldolgozás Indítása";
        }
      });
    </script>
  </body>
</html>