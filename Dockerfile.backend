FROM node:22-slim

WORKDIR /app

# Függőségek és kódok másolása (backend és shared egyben)
COPY backend/package*.json ./backend/
COPY shared ./shared

WORKDIR /app/backend
RUN npm install

COPY backend ./

# TypeScript fordítás futtatása
RUN npm run build

ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

# A lefordított belépési pont indítása
CMD ["node", "dist/backend/src/index.js"]