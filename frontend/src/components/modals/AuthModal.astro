---
// frontend/src/components/modals/AuthModal.astro
---
<dialog id="authModal" class="modal modal-bottom sm:modal-middle">
  <div class="modal-box max-w-sm p-6 bg-base-100">
    <div
      class="flex justify-between items-center border-b border-base-200 pb-3 mb-4"
    >
      <h3 class="font-bold text-lg text-primary" id="authModalTitle">
        Bejelentkezés
      </h3>
      <form method="dialog">
        <button class="btn btn-sm btn-circle btn-ghost">✕</button>
      </form>
    </div>

    <div role="tablist" class="tabs tabs-boxed mb-4">
      <a role="tab" id="authTabLogin" class="tab tab-active">Belépés</a>
      <a role="tab" id="authTabRegister" class="tab">Regisztráció</a>
    </div>

    <form id="authForm" class="space-y-3">
      <div>
        <label class="label label-text text-xs p-0 mb-1">E-mail cím</label>
        <input
          type="email"
          id="authEmail"
          required
          class="input input-sm input-bordered w-full"
          placeholder="pelda@ceg.hu"
        />
      </div>
      <div>
        <label class="label label-text text-xs p-0 mb-1">Jelszó</label>
        <input
          type="password"
          id="authPassword"
          required
          minlength="6"
          class="input input-sm input-bordered w-full"
          placeholder="••••••••"
        />
        <div class="flex justify-end mt-1" id="forgotPasswordContainer">
          <a href="#" id="forgotPasswordLink" class="text-xs text-primary link link-hover">Elfelejtetted a jelszavad?</a>
        </div>
      </div>

      <div
        id="authErrorAlert"
        class="hidden alert alert-error text-xs p-2 rounded-lg"
      >
      </div>

      <button
        type="submit"
        id="authSubmitBtn"
        class="btn btn-primary btn-sm w-full mt-2"
      >
        Bejelentkezés
      </button>
    </form>
  </div>
</dialog>
