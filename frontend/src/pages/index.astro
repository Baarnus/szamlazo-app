---
import "../styles/global.css";
import { SUPPORTED_CURRENCIES } from "../../../shared/types";
---

<html lang="hu" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Google Consent Mode v2 Default Setup -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        'analytics_storage': 'denied',
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'wait_for_update': 500
      });
      gtag('set', 'url_passthrough', true);
    </script>
    
    <!-- CookieConsent V3 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@v3.0.0/dist/cookieconsent.css">

    <script
      defer
      src="https://umami-89-58-60-86.sslip.io/script.js"
      data-website-id="70ac19ad-2a82-40b9-b32d-aa6a46daad84"></script>
    <title>Számla AI - Okos Bizonylatkezelő & Könyvelési OCR</title>
  </head>
  <body class="min-h-screen bg-base-300 p-3 md:p-8 font-sans">
    <div class="max-w-5xl mx-auto space-y-6">
      <!-- FEJLÉC (Navbar) -->
      <header
        class="navbar bg-base-100 shadow-lg rounded-box px-4 md:px-6 py-2.5 flex justify-between items-center border border-base-200"
      >
        <div class="flex items-center gap-2">
          <span class="text-2xl">🧾</span>
          <div>
            <h1
              class="font-extrabold text-base sm:text-lg md:text-xl text-primary tracking-tight whitespace-nowrap"
            >
              Számla AI
            </h1>
            <p class="text-[10px] text-base-content/50 hidden sm:block">
              Automatikus számlafeldolgozás másodpercek alatt
            </p>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <!-- BEJELENTKEZETT ÁLLAPOT -->
          <div id="userProfileBar" class="hidden items-center gap-2">
            <div
              class="badge badge-primary font-semibold text-xs py-2.5 px-3 gap-1 shadow-sm"
            >
              <span>⚡</span>
              <span id="userCreditsDisplay">0</span>
              <span class="opacity-80 font-normal">kredit</span>
            </div>

            <!-- KIEMELT ZÖLD FELTÖLTÉS GOMB -->
            <button
              type="button"
              id="openBillingBtn"
              class="btn btn-xs bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-3 border-0 shadow"
            >
              + Feltöltés
            </button>

            <button
              type="button"
              id="openSettingsBtn"
              class="btn btn-ghost btn-xs text-base-content font-medium"
            >
              ⚙️ Beállítások
            </button>

            <button
              type="button"
              id="logoutBtn"
              class="btn btn-ghost btn-xs text-error font-medium"
            >
              Kijelentkezés
            </button>
          </div>

          <!-- KIJELENTKEZETT ÁLLAPOT -->
          <div id="guestNavAction" class="flex items-center gap-2">
            <button
              id="openAuthModalBtn"
              type="button"
              class="btn btn-primary btn-sm gap-1 shadow-md"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                ></path>
              </svg>
              Belépés / Fiók
            </button>
          </div>
        </div>
      </header>

      <!-- ======================================================== -->
      <!-- 1. LANDING PAGE NÉZET (Csak kijelentkezve látható)       -->
      <!-- ======================================================== -->
      <main id="guestLandingView" class="space-y-12 py-4">
        <!-- Hero Szekció -->
        <section class="text-center space-y-6 pt-4 sm:pt-8">
          <div
            class="inline-flex items-center gap-2 bg-primary/10 text-primary border border-primary/20 rounded-full px-4 py-1 text-xs font-semibold"
          >
            <span>✨</span> Mesterséges Intelligencia alapú bizonylatfelismerés
          </div>

          <h2
            class="text-3xl sm:text-5xl font-black tracking-tight leading-tight max-w-3xl mx-auto"
          >
            Felejtsd el a kézi számlagépelést. <br class="hidden sm:inline" />
            <span
              class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent"
            >
              Fotózz, ismerj fel, exportálj.
            </span>
          </h2>

          <p
            class="text-sm sm:text-base text-base-content/70 max-w-2xl mx-auto leading-relaxed"
          >
            A Számla AI másodpercek alatt kinyeri a kiállítót, tételsorokat,
            áfaértékeket és határidőket a fotózott bizonylatokból vagy PDF-ekből
            — könyvelőbarát CSV és könyvelőszoftver-kompatibilis formátumban.
          </p>

          <div
            class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2"
          >
            <button
              type="button"
              class="btn btn-primary btn-md w-full sm:w-auto shadow-lg text-base hero-register-cta"
            >
              🚀 15 Ingyenes kredit azonnal
            </button>
            <a
              href="#howItWorks"
              class="btn btn-ghost btn-md w-full sm:w-auto text-sm"
            >
              Hogyan működik? ↓
            </a>
          </div>

          <!-- Értékelés / Bizalmi indikátor -->
          <div
            class="flex flex-wrap items-center justify-center gap-6 text-xs text-base-content/60 pt-4"
          >
            <span class="flex items-center gap-1"
              >✓ Magyar és külföldi számlák</span
            >
            <span class="flex items-center gap-1">✓ 99.4% AI pontosság</span>
            <span class="flex items-center gap-1"
              >✓ 0 Ft havidíj (Pay-as-you-go)</span
            >
          </div>
        </section>

        <!-- Interaktív Előnézet Kártya (Illusztráció) -->
        <section
          class="card bg-base-100 border border-base-200 shadow-2xl p-4 sm:p-6"
        >
          <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
            <div
              class="md:col-span-5 bg-base-200/60 rounded-2xl p-4 border border-base-300 flex flex-col items-center justify-center text-center space-y-3 min-h-[220px]"
            >
              <div
                class="w-16 h-20 bg-base-100 border border-base-300 rounded-lg shadow-sm flex flex-col p-2 space-y-1 rotate-[-3deg]"
              >
                <div class="w-full h-2 bg-primary/30 rounded"></div>
                <div class="w-3/4 h-1.5 bg-base-300 rounded"></div>
                <div class="w-1/2 h-1.5 bg-base-300 rounded"></div>
                <div class="w-full h-4 bg-base-200 rounded mt-auto"></div>
              </div>
              <p class="text-xs font-semibold text-base-content/80">
                Gyűrött számla / Külföldi blokk / PDF
              </p>
              <span class="badge badge-sm badge-outline"
                >Bármilyen minőség vagy nyelv</span
              >
            </div>

            <div class="md:col-span-2 flex justify-center">
              <div
                class="badge badge-primary badge-lg py-3 px-4 font-bold shadow-md"
              >
                AI Feldolgozás ➔
              </div>
            </div>

            <div
              class="md:col-span-5 bg-base-200/40 rounded-2xl p-4 border border-base-300 space-y-2 text-xs"
            >
              <div
                class="flex justify-between items-center border-b border-base-300 pb-2"
              >
                <span class="font-bold text-primary">Strukturált Adatok</span>
                <span class="badge badge-success badge-xs">✓ Valid</span>
              </div>
              <div class="flex justify-between">
                <span class="text-base-content/60">Partner:</span>
                <b class="truncate">Google Cloud EMEA Ltd.</b>
              </div>
              <div class="flex justify-between">
                <span class="text-base-content/60">Számlaszám:</span>
                <span class="font-mono">INV-2026-9812</span>
              </div>
              <div class="flex justify-between">
                <span class="text-base-content/60">Nettó / ÁFA:</span>
                <span>100.00 EUR / 27.00 EUR</span>
              </div>
              <div
                class="flex justify-between font-bold text-success pt-1 border-t border-base-300"
              >
                <span>Bruttó végösszeg:</span>
                <span>127.00 EUR</span>
              </div>
            </div>
          </div>
        </section>

        <!-- 3 Lépéses folyamat szekció -->
        <section id="howItWorks" class="space-y-6 pt-4">
          <div class="text-center space-y-2">
            <h3 class="text-2xl font-bold tracking-tight">
              Hogyan működik 3 egyszerű lépésben?
            </h3>
            <p class="text-xs sm:text-sm text-base-content/60">
              Nem kell appot telepítened, böngészőből és mobilról is azonnal
              elérhető.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div
              class="card bg-base-100 border border-base-200 p-5 space-y-3 shadow-md"
            >
              <div
                class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-black text-lg"
              >
                1
              </div>
              <h4 class="font-bold text-sm">Fotózd be vagy töltsd fel</h4>
              <p class="text-xs text-base-content/70 leading-relaxed">
                Húzd be a PDF fájlokat, képeket, vagy használd a mobilkamerádat
                közvetlenül a böngészőből.
              </p>
            </div>

            <div
              class="card bg-base-100 border border-base-200 p-5 space-y-3 shadow-md"
            >
              <div
                class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-black text-lg"
              >
                2
              </div>
              <h4 class="font-bold text-sm">Azonnali AI felismerés</h4>
              <p class="text-xs text-base-content/70 leading-relaxed">
                A rendszer kinyeri az összes tételt, adószámot, pénznemet, és
                automatikusan leellenőrzi a matematikai egyezést.
              </p>
            </div>

            <div
              class="card bg-base-100 border border-base-200 p-5 space-y-3 shadow-md"
            >
              <div
                class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-black text-lg"
              >
                3
              </div>
              <h4 class="font-bold text-sm">1 kattintásos Export</h4>
              <p class="text-xs text-base-content/70 leading-relaxed">
                Töltsd le a könyvelésre készített összesített CSV fájlt, amit
                közvetlenül továbbíthatsz a könyvelődnek.
              </p>
            </div>
          </div>
        </section>

        <!-- Kredit Csomagok (Árazási Előnézet) -->
        <section class="space-y-6 pt-4">
          <div class="text-center space-y-2">
            <h3 class="text-2xl font-bold tracking-tight">
              Kreditcsomagok — Havidíj nélkül
            </h3>
            <p class="text-xs sm:text-sm text-base-content/60">
              Csak azért fizetsz, amit ténylegesen feldolgozol. A kreditek sosem
              járnak le.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <!-- Kezdő -->
            <div
              class="card bg-base-100 border border-base-300 p-5 flex flex-col justify-between hover:border-primary transition-all"
            >
              <div>
                <h4 class="font-bold text-sm">Kezdő</h4>
                <div class="text-2xl font-black my-2 text-primary">
                  50 <span class="text-xs font-normal text-base-content/60"
                    >kredit</span>
                </div>
                <p class="text-sm font-semibold">2 990 Ft</p>
                <p class="text-[11px] text-base-content/50">~60 Ft / számla</p>
              </div>
              <button
                type="button"
                class="btn btn-outline btn-primary btn-sm w-full mt-6 hero-register-cta"
                >Kipróbálom</button
              >
            </div>

            <!-- Pro -->
            <div
              class="card bg-primary/5 border-2 border-primary p-5 flex flex-col justify-between relative shadow-xl"
            >
              <span
                class="badge badge-primary badge-xs absolute -top-2.5 right-4 font-semibold"
                >Legnépszerűbb</span
              >
              <div>
                <h4 class="font-bold text-sm">Pro</h4>
                <div class="text-2xl font-black my-2 text-primary">
                  150 <span class="text-xs font-normal text-base-content/60"
                    >kredit</span>
                </div>
                <p class="text-sm font-semibold">6 990 Ft</p>
                <p class="text-[11px] text-base-content/50">~46 Ft / számla</p>
              </div>
              <button
                type="button"
                class="btn btn-primary btn-sm w-full mt-6 hero-register-cta"
                >Választom</button
              >
            </div>

            <!-- Üzleti -->
            <div
              class="card bg-base-100 border border-base-300 p-5 flex flex-col justify-between hover:border-primary transition-all"
            >
              <div>
                <h4 class="font-bold text-sm">Üzleti</h4>
                <div class="text-2xl font-black my-2 text-primary">
                  500 <span class="text-xs font-normal text-base-content/60"
                    >kredit</span>
                </div>
                <p class="text-sm font-semibold">17 990 Ft</p>
                <p class="text-[11px] text-base-content/50">~36 Ft / számla</p>
              </div>
              <button
                type="button"
                class="btn btn-outline btn-primary btn-sm w-full mt-6 hero-register-cta"
                >Választom</button
              >
            </div>
          </div>
        </section>

        <!-- Alsó CTA Sáv -->
        <section
          class="card bg-gradient-to-r from-primary/20 via-base-100 to-primary/10 border border-primary/30 p-6 text-center space-y-4 shadow-xl"
        >
          <h3 class="text-xl sm:text-2xl font-bold">
            Készen állsz az automatizálásra?
          </h3>
          <p class="text-xs sm:text-sm text-base-content/70 max-w-xl mx-auto">
            Regisztrálj másodpercek alatt bankkártya megadása nélkül, és kapsz
            15 ingyenes kreditet a teszteléshez.
          </p>
          <button
            type="button"
            class="btn btn-primary btn-md shadow-md hero-register-cta"
          >
            Ingyenes fiók létrehozása
          </button>
        </section>
      </main>

      <!-- ======================================================== -->
      <!-- 2. APPLIKÁCIÓ / DASHBOARD NÉZET (Csak belépve látható)  -->
      <!-- ======================================================== -->
      <main id="appDashboardView" class="space-y-5 hidden">
        <!-- Beviteli doboz Fülekkel -->
        <div class="card bg-base-100 shadow-xl border border-base-200">
          <div class="card-body p-4 md:p-6">
            <div role="tablist" class="tabs tabs-boxed mb-3">
              <a role="tab" id="tabUpload" class="tab tab-active font-medium"
                >Fájl feltöltés / Kamera</a
              >
              <a role="tab" id="tabUrl" class="tab font-medium"
                >Kép URL linkek</a
              >
              <a role="tab" id="tabTextPrompt" class="tab font-medium"
                >🤖 Szöveges Prompt</a
              >
            </div>

            <!-- 1. Fül: Fájlok feltöltése / Mobil Kamera / Drag & Drop -->
            <div id="panelUpload" class="space-y-3">
              <div class="block md:hidden">
                <button
                  type="button"
                  id="cameraBtn"
                  class="btn btn-primary w-full gap-2 text-base font-semibold shadow-md py-3"
                >
                  📸 Számla Fotózása
                </button>

                <input
                  type="file"
                  id="cameraInput"
                  accept="image/*"
                  capture="environment"
                  class="hidden"
                />
              </div>

              <!-- Drop Zone & Fájlböngésző -->
              <div
                id="dropZone"
                class="border-2 border-dashed border-base-content/20 hover:border-primary rounded-2xl p-5 text-center cursor-pointer transition-all duration-200 bg-base-200/40 hover:bg-base-200/80 flex flex-col items-center justify-center min-h-[120px] gap-1"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-8 w-8 text-primary/70 mb-1"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"
                  ></path>
                </svg>
                <p class="font-medium text-xs sm:text-sm">
                  Húzd ide a számlákat, <span class="text-primary underline"
                    >tallózd be</span
                  >, vagy nyomj <kbd class="kbd kbd-xs">Ctrl</kbd> + <kbd
                    class="kbd kbd-xs">V</kbd
                  >-t
                </p>
                <p class="text-[11px] text-base-content/60">
                  Maximum 10 kép kötegenként
                </p>
                <input
                  type="file"
                  id="fileInput"
                  accept="image/*"
                  multiple
                  class="hidden"
                />
              </div>

              <!-- Kijelölt képek előnézete -->
              <div id="previewContainer" class="hidden space-y-2">
                <div class="flex justify-between items-center">
                  <span
                    class="text-xs font-semibold text-base-content/70"
                    id="fileCountBadge"
                  >
                    Kiválasztva: 0/10 kép
                  </span>
                  <button
                    type="button"
                    id="clearFilesBtn"
                    class="btn btn-ghost btn-xs text-error"
                  >
                    Összes törlése
                  </button>
                </div>
                <div
                  id="previewGrid"
                  class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3"
                >
                </div>
              </div>
            </div>

            <!-- 2. Fül: URL-ek megadása -->
            <div id="panelUrl" class="hidden space-y-3">
              <label class="block text-xs text-base-content/70">
                Illeszd be a képek közvetlen URL-jét (soronként 1 link, max 10
                db):
              </label>
              <textarea
                id="urlInput"
                rows="3"
                placeholder="https://pelda.hu/szamla1.jpg&#10;https://pelda.hu/szamla2.png"
                class="textarea textarea-bordered w-full font-mono text-xs"
              ></textarea>
            </div>

            <!-- 3. Fül: Szöveges (AI) Prompt megadása -->
            <div id="panelTextPrompt" class="hidden space-y-3">
              <label class="block text-xs text-base-content/70">
                Írd le egyszerűen, hogy kinek és miről szeretnél számlát kiállítani:
              </label>
              <textarea
                id="textPromptInput"
                rows="3"
                placeholder="Például: Számlát szeretnék kiállítani a Kovács Kft-nek (11111111-2-41), címe: Budapest, Fő utca 1. Fejlesztés 50.000 Ft áfamentesen."
                class="textarea textarea-bordered w-full text-sm"
              ></textarea>
            </div>

            <div class="card-actions justify-end mt-3">
              <button
                id="processBtn"
                type="button"
                class="btn btn-primary w-full md:w-auto"
              >
                Feldolgozás Indítása
              </button>
            </div>
          </div>
        </div>

        <!-- Globális Státusz és Export Sáv -->
        <div
          id="statusAlert"
          class="hidden alert shadow-lg flex-col md:flex-row justify-between items-center gap-4"
        >
          <div class="flex-1 w-full space-y-1">
            <div class="flex justify-between items-center">
              <span id="statusMessage" class="font-medium text-sm"></span>
              <span id="progressPercent" class="text-xs font-bold"></span>
            </div>
            <progress
              id="progressBar"
              class="progress progress-primary w-full hidden"
              value="0"
              max="100"></progress>
          </div>
          <button
            id="exportCsvBtn"
            type="button"
            class="btn btn-sm btn-neutral gap-2 hidden"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
              ></path>
            </svg>
            CSV Exportálása
          </button>
        </div>

        <!-- Élő Feldolgozási Sorrend Napló Panel -->
        <div
          id="logBoxContainer"
          class="hidden card bg-base-100 shadow-md border border-base-200"
        >
          <div class="card-body p-3">
            <div class="flex justify-between items-center mb-1">
              <span
                class="text-xs font-bold uppercase tracking-wider text-base-content/70 flex items-center gap-2"
              >
                <span
                  class="inline-block w-2 h-2 rounded-full bg-success animate-pulse"
                ></span>
                Élő Feldolgozási Napló
              </span>
              <span class="text-[11px] text-base-content/50" id="logSpeedInfo"
              ></span>
            </div>
            <div
              id="activityLog"
              class="space-y-1 font-mono text-xs max-h-36 overflow-y-auto bg-base-200/50 p-2 rounded-lg border border-base-300"
            >
            </div>
          </div>
        </div>

        <!-- Eredmények konténere -->
        <div id="resultsWrapper" class="space-y-5"></div>
      </main>
    </div>

    <!-- LÁBLÉC (JOGI DOKUMENTUMOK) -->
    <footer class="footer footer-center p-6 bg-base-200 text-base-content rounded-t-lg mt-10">
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/aszf" class="link link-hover text-sm">Általános Szerződési Feltételek (ÁSZF)</a>
        <a href="/adatvedelem" class="link link-hover text-sm">Adatvédelmi Tájékoztató (GDPR)</a>
      </div>
      <div>
        <p class="text-xs opacity-70">Copyright © 2026 - Minden jog fenntartva | Számla AI</p>
      </div>
    </footer>

    <!-- KREDIT VÁSÁRLÁS MODAL (Stripe) -->
    <dialog id="billingModal" class="modal modal-bottom sm:modal-middle">
      <div class="modal-box max-w-2xl bg-base-100 p-6">
        <div
          class="flex justify-between items-center border-b border-base-200 pb-3 mb-4"
        >
          <h3 class="font-bold text-lg text-primary flex items-center gap-2">
            ⚡ Kreditek feltöltése
          </h3>
          <form method="dialog">
