FROM node:22-slim

WORKDIR /app

# Függőségek és kódok másolása (backend és shared egyben)
COPY shared ./shared
RUN cd ./shared && npm install --include=dev

COPY backend/package*.json ./backend/
WORKDIR /app/backend
# --include=dev biztosítja, hogy a typescript (tsc) feltelepüljön NODE_ENV=production esetén is
RUN npm install --include=dev

COPY backend ./

# TypeScript fordítás futtatása
RUN npm run build

ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

# Jogosultságok átadása a beépített node felhasználónak a rootként futás megelőzésére
RUN chown -R node:node /app

USER node

# A lefordított belépési pont indítása
CMD ["node", "dist/backend/src/index.js"]